.

ibbeox:_CountOf_DistinctBrandOfferingsWithin
	rdf:type ibbeo:CountOf ;
	skos:prefLabel "# of Distinct Product / Service Offerings"@en ;
	skos:definition "The count of distinct product / service offerings within something."@en ;
.

ibbeox:_CountOf_DistinctCompetingTopParentsItHas
	rdf:type ibbeo:CountOf ;
	skos:prefLabel "# of Distinct Competing Top Parents"@en ;
	skos:definition "The count of distinct competing top parents something is known to have."@en ;
.

ibbeox:_CountOf_DistinctCompetingTopParentsWithin
	rdf:type ibbeo:CountOf ;
	skos:prefLabel "# of Distinct Competing Top Parents"@en ;
	skos:definition "The count of distinct competing top parents within something."@en ;
.

ibbeox:_CountOf_DistinctDivisionsWithin
	rdf:type ibbeo:CountOf ;
	skos:prefLabel "# of Distinct Divisions"@en ;
