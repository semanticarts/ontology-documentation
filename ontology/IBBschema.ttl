ibbeox:_OrganizationLevel_BrandedOffering
	a ibbeo:OrganizationLevel ;
	skos:definition "A specific type of product or service offering that typically has an associated brand. It is the most specific level in the organizational structure starting from a general top parent down to what people buy in the marketplace."@en ;
	skos:example "Barqs Root Beer"@en ;
	skos:prefLabel "Product / Service Offering"@en ;
	skos:scopeNote "Strictly speaking, a product or service offering is not a kind of company or organization. It is a part of an organizational structure that defines an industry. It is slightly more general than a gist:CatalogItem that would be part of a gist:Offer."@en ;
	.

ibbeox:_OrganizationLevel_Division
	a ibbeo:OrganizationLevel ;
	skos:definition "An organization within a larger organization. The division typically does not have legal status."@en ;
	skos:example "Healthy Valley Organic, which is part of the Hain Celestial Group Inc."@en ;
	skos:prefLabel "Division"@en ;
	skos:scopeNote "Divisions are conceived to be part of the organizational structure of a company. They may or may not correspond to an actual organizational unit in the company."@en ;
	.

ibbeox:_OrganizationLevel_Subsidiary
	a ibbeo:OrganizationLevel ;
	skos:definition "A company that is itself a legal entity, but is owned by a larger company."@en ;
	skos:example "Buffalo Wild Wings, part of the Roark Capital Group"@en ;
	skos:prefLabel "Subsidiary"@en ;
	skos:scopeNote "A subsidiary may be either public or private."@en ;
	.

ibbeox:_OrganizationLevel_TopParent
	a ibbeo:OrganizationLevel ;
	skos:definition "A organization that is not part of any other organization. It has legal status."@en ;
	skos:example "Russel Stover"@en ;
	skos:prefLabel "Top Parent"@en ;
	.

ibbeox:_PublicTradingStatus_NotPubliclyTraded
	a ibbeo:PublicTradingStatus ;
	skos:definition "A category indicating that a company is not publicly traded."@en ;
	skos:prefLabel "Not Publicly Traded"@en ;
	.

ibbeox:_PublicTradingStatus_PubliclyTraded
	a ibbeo:PublicTradingStatus ;
	skos:definition "A category indicating that a company is publicly traded."@en ;
	skos:prefLabel "Publicly Traded"@en ;
	.

ibbeox:_ValueType_Category
	a ibbeo:ValueType ;
	skos:definition "An individual used to indicate that something is characterized as a category value"@en ;
	skos:prefLabel "Value Type"@en ;
	.

ibbeox:_ValueType_Scalar
	a ibbeo:ValueType ;
	skos:definition "Used to denote values that are scalar numbers"@en ;
	skos:prefLabel "Scalar Value Type"@en ;
	.

ibbeox:_Visibility_Hidden
	a ibbeo:Visibility ;
	skos:definition "This indicates that a thing is hidden from view within an application."@en ;
	skos:note "Information prohibited from being viewed in the application"@en ;
	skos:prefLabel "Hidden"@en ;
	.

ibbeox:_Visibility_Visible
	a ibbeo:Visibility ;
	skos:definition "This indicates that a thing is visible within an application."@en ;
	skos:note "Information permitted to be viewed in the application"@en ;
	skos:prefLabel "Visible"@en ;
	.

ibbeox:_selectable
	a gist:Category ;
	skos:definition "This indicates that a thing is selectable within an application."@en ;
	skos:note "Used by the demo application."@en ;
	skos:prefLabel "Selectable"@en ;
	.

ibbeox:_usdollar_per_usdollar
	a ibbeo:CurrencyPerCurrencyUnit ;
	skos:prefLabel "US Dollar per US Dollar"@en ;
	gist:conversionFactor "1.0"^^xsd:double ;
	gist:hasNumerator gist:_USDollar ;
	gist:hasDenominator gist:_USDollar ;
	gist:hasStandardUnit ibbeox:_usdollar_per_usdollar ;
	.

ibbeox:_usdollars_per_year
	a ibbeo:CurrencyPerDurationUnit ;
	skos:prefLabel "US Dollars per Year"@en ;
	gist:conversionFactor "1.0"^^xsd:double ;
	gist:hasNumerator gist:_USDollar ;
	gist:hasDenominator ibbeox:_year ;
	gist:hasStandardUnit ibbeox:_usdollars_per_year ;
	.

ibbeox:_usdollars_per_year_per_usdollars_per_year
	a ibbeo:CurrencyPerDurationPercentageUnit ;
	skos:prefLabel "US Dollars per Year per US Dollars per Year"@en ;
	gist:conversionFactor "1.0"^^xsd:double ;
	gist:hasNumerator ibbeox:_usdollars_per_year ;
	gist:hasDenominator ibbeox:_usdollars_per_year ;
	gist:hasStandardUnit ibbeox:_usdollars_per_year_per_usdollars_per_year ;
	.

ibbeox:_year
	a gist:DurationUnit ;
	skos:definition "A duration unit that is 365.256 days long."@en ;
	skos:prefLabel "Year"@en ;
	# Based on the number of ephemeris days for the J2000.0 epoch in a [sidereal
	# year](https://en.wikipedia.org/wiki/Sidereal_year) rounded to 3 decimal
	# points.
	# 365.256 * 86400 = 31,558,118.4
	gist:conversionFactor "31558118.4"^^xsd:double ;
	gist:hasBaseUnit gist:_second ;
	.
