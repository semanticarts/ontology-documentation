.

ibbeox:_CountOf_DistinctIndustryGroupsItCompetesIn
	rdf:type ibbeo:CountOf ;
	skos:prefLabel "# of Distinct Industry Groups it Competes In"@en ;
	skos:definition "The count of distinct industry groups something competes in."@en ;
.

ibbeox:_CountOf_DistinctIndustryGroupsWithin
	rdf:type ibbeo:CountOf ;
	skos:prefLabel "# of Distinct Industry Groups"@en ;
	skos:definition "The count of distinct industry groups within something."@en ;
.

ibbeox:_CountOf_DistinctIndustrySubsectorsWithin
	rdf:type ibbeo:CountOf ;
	skos:prefLabel "# of Distinct Industry Subsectors"@en ;
	skos:definition "The count of distinct industry subsectors within something."@en ;
.

ibbeox:_CountOf_DistinctIndustrySectorsWithin
	rdf:type ibbeo:CountOf ;
	skos:prefLabel "# of Distinct Industry Sectors"@en ;
	skos:definition "The count of distinct industry sectors within something."@en ;
.

ibbeox:_CountOf_DistinctIndustrySupersectorsWithin
	rdf:type ibbeo:CountOf ;
	skos:prefLabel "# of Distinct Industry Supersectors"@en ;
	skos:definition "The count of distinct industry supersectors within something."@en ;
.

ibbeox:_CountOf_DistinctIntermediateLevelsWithin
	rdf:type ibbeo:CountOf ;
	skos:prefLabel "# of Distinct Divisions and Subsidiaries"@en ;
