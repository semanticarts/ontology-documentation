# 	skos:prefLabel "value of"@en ;
# .

ibbeo:weight
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf gist:numericValue ;
	skos:definition "relates to a modifying weight value used for e.g. IBB Five Forces"@en ;
	skos:prefLabel "Weight"@en ;
	.

<https://taxonomies.industrybuildingblocks.com/t/ibbTaxo>
	a owl:Ontology ;
	owl:imports
		<http://www.w3.org/2004/02/skos/core> ,
		<https://ontologies.industrybuildingblocks.com/o/ibbMain>
		;
	skos:definition "Taxonomic concepts supporting IBB core business"@en ;
	skos:prefLabel "ibbTaxo"@en ;
	.

ibbeox:_AnnualRevenueCategory_TotalIndustry
	rdf:type ibbeo:AnnualRevenueCategory ;
	skos:prefLabel "Total Industry Annual Revenue"@en ;
	skos:definition "The total annual revenue of all industries within some grouping of the industries."@en ;
.

ibbeox:_AnnualRevenueCategory_TotalLawfulIndustry
	rdf:type ibbeo:AnnualRevenueCategory ;
	skos:prefLabel "Total Lawful Industry Annual Revenue"@en ;
	skos:definition "The total annual revenue of all lawful industries within some grouping of the industries."@en ;
.

ibbeox:_AnnualRevenueCategory_TotalUnlawfulIndustry
	rdf:type ibbeo:AnnualRevenueCategory ;
	skos:prefLabel "Total Unlawful Industry Annual Revenue"@en ;
	skos:definition "The total annual revenue of all unlawful industries within some grouping of the industries."@en ;
.

ibbeox:_AnnualRevenuePercentageCategory_OfTotalAnnualIndustryRevenueOfLawfulEconomy
	rdf:type ibbeo:AnnualRevenuePercentageCategory ;
	skos:prefLabel "Percentage of Total Industry Annual Revenue"@en ;
	skos:definition "The percentage of the total annual revenue of all industries within some grouping of the industries relative to the whole economy (excluding unlawful industries)."@en ;
.

ibbeox:_Characteristic_BuyerPower
	a ibbeo:Characteristic ;
	skos:definition "A Characteristic that is referenced to characterize something as a 5 Forces Score related to the dimension 'Buyer Power Score'."@en ;
	skos:prefLabel "Buyer Power Score"@en ;
	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
	.

ibbeox:_Characteristic_ChannelPower
	a ibbeo:Characteristic ;
	skos:definition "A Characteristic that is referenced to characterize something as a 5 Forces Score related to the dimension 'Channel Power Score'."@en ;
	skos:prefLabel "Channel Power Score"@en ;
	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
	.

ibbeox:_Characteristic_CompetitiveRivalry
	a ibbeo:Characteristic ;
	skos:definition "A Characteristic that is referenced to characterize something as a 5 Forces Score related to the dimension 'Competitive Rivalry Score'."@en ;
	skos:prefLabel "Competitive Rivalry Score"@en ;
	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
	.

ibbeox:_Characteristic_CustomerPower
	a ibbeo:Characteristic ;
	skos:definition "A Characteristic that is referenced to characterize something as a 5 Forces Score related to the dimension 'Customer Power Score'."@en ;
	skos:prefLabel "Customer Power Score"@en ;
	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
	.

ibbeox:_Characteristic_IndustryAttractivenessGrade
	a ibbeo:Characteristic ;
	skos:definition "A Characteristic that is referenced to characterize something as a 5 Forces  'Industry Attractiveness Grade'."@en ;
	skos:note """(Column Q is the Industry Attractiveness Score)

IF(Q6<96,'5 Very Low',IF (Q6<108,'4 Low',IF (Q6<113,'3 Medium',IF (Q6<125,'2 High','1 Very High'))))"""@en ;
	skos:prefLabel "Attractiveness Grade"@en ;
	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
	.

ibbeox:_Characteristic_IndustryAttractivenessScore
	a ibbeo:Characteristic ;
	skos:definition "A Characteristic that is referenced to characterize something as a 5 Forces Score related to the dimension 'Industry Attractiveness'."@en ;
	skos:note """Industry Attractiveness Is Determined by the Five Forces plus several additional factors.
(Col K is Industry Size factor; L is Industry growth factor; M is Industry Risk
factor; P is the 5 Forces Industry Score)

MIN(150,SUM(K6,L6,M6,P6))"""@en ;
	skos:prefLabel "Attractiveness Score"@en ;
	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
	.

ibbeox:_Characteristic_IndustryFiveForcesScore
	a ibbeo:Characteristic ;
	skos:definition "A Characteristic that is the weighted average of the 5 Forces scores."@en ;
	skos:prefLabel "Five Forces Score"@en ;
	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
	.

# ibbeox:_Characteristic_IndustryFiveForcesSummaryScore
# 	a ibbeo:Characteristic ;
# 	skos:definition "A Characteristic that is referenced to characterize something as a 5 Forces Score."@en ;
# 	skos:note """(Columns AZ:BE shows weights of the forces. BF:BK show weights)
# 200 ROUND(SUMPRODUCT(Raw!AZ6:BE6,Raw!BF6:BK6),0)"""@en ;
# 	skos:prefLabel "5 Forces Score"@en ;
# 	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
# 	.

ibbeox:_Characteristic_IndustryGrowthRateFactor
	a ibbeo:Characteristic ;
	skos:definition "A Characteristic that is referenced to characterize something as an 'Industry Growth Factor' within the 5 Forces Score framework."@en ;
	skos:note """(Columns AS, AT + AU show Industry Growth Data for 3 years)
MIN(10,ROUND(SQRT(PRODUCT(100,MAX(0,SUM(Raw!AS6+Raw!AT6+Raw!AU6 0.1)))),0)))"""@en ;
	skos:prefLabel "Growth Rate Factor"@en ;
	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
	.

ibbeox:_Characteristic_IndustrySizeFactor
	a ibbeo:Characteristic ;
	skos:definition "A Characteristic that is referenced to characterize something as an 'Industry Size Factor' within the 5 Forces Score framework."@en ;
	skos:note """(Columns C, D + E show Industry Revenue Data for 3 years)
MIN(10,ROUND(SQRT(ROUND(SUM(C6+D6+E6)/1000,0)),0))"""@en ;
	skos:prefLabel "Size Factor"@en ;
	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
	.

ibbeox:_Characteristic_IndustryStabilityRiskFactor
	a ibbeo:Characteristic ;
	skos:definition "A Characteristic that is referenced to characterize something as an 'Industry Risk Factor' within the 5 Forces Score framework."@en ;
	skos:note """(Column BM shows a stability score from 1 to 17)
4 ROUND(0.5*Raw!BM6,0)"""@en ;
	skos:prefLabel "Stability Risk Factor"@en ;
	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
	.

ibbeox:_Characteristic_PowerOfPotentialEntrants
	a ibbeo:Characteristic ;
	skos:definition "A Characteristic that is referenced to characterize something as a 5 Forces Score related to the dimension 'Power of Potential Entrants Score'."@en ;
	skos:prefLabel "Power Of Potential Entrants Score"@en ;
	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
	.

ibbeox:_Characteristic_SubstitutePower
	a ibbeo:Characteristic ;
	skos:definition "A Characteristic that is referenced to characterize something as a 5 Forces Score related to the dimension 'Substitute Power Score'."@en ;
	skos:prefLabel "Substitute Power Score"@en ;
	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
	.

ibbeox:_Characteristic_VendorPower
	a ibbeo:Characteristic ;
	skos:definition "A Characteristic that is referenced to characterize something as a 5 Forces Score related to the dimension 'Vendor Power Score'."@en ;
	skos:prefLabel "Vendor Power Score"@en ;
	ibbeo:hasValueType ibbeox:_ValueType_Scalar ;
	.

