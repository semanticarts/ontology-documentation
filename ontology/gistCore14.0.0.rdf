  <rdf:Description rdf:nodeID="A287">
    <rdf:rest rdf:nodeID="A288"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A270">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/offersToReceive"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A289">
    <rdf:rest rdf:nodeID="A290"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoRegion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A288">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/requires">
    <skos:scopeNote>This predicate is defined generally enough to encompass a few different meanings of the English word 'requires':&#xD;
&#xD;
		1. To need something or to make something necessary.&#xD;
		2. To order or demand something, or to order someone to do something, especially because of a rule or law.&#xD;
		3. To make it officially necessary for someone to do something.&#xD;
&#xD;
	Implementations requiring a more specific meaning should define subproperties.</skos:scopeNote>
    <skos:prefLabel>requires</skos:prefLabel>
    <skos:example>Humans require air; solar power requires sunshine.</skos:example>
    <skos:definition>The subject needs the object or makes it necessary, mandatory, or compulsory.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A291">
    <owl:unionOf rdf:nodeID="A292"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A23">
    <rdf:rest rdf:nodeID="A293"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/SchemaMetaData">
    <skos:scopeNote>The definition of this class needs additional work.</skos:scopeNote>
    <skos:prefLabel>Schema Meta Data</skos:prefLabel>
    <skos:example>Relational concepts, such as tables and columns; tool inputs, such as queries and R2RML maps.</skos:example>
    <skos:definition>Superclass for all types of metadata.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A178">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A294"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A295">
    <owl:unionOf rdf:nodeID="A296"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfRadian">
    <skos:prefLabel>exponent of radian</skos:prefLabel>
    <skos:example>In the equation '1 revolution = 6.283 x radian'&#xD;
&#xD;
		the conversion factor for revolution is 6.283&#xD;
		the exponent of radian is 1&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing revolution must be a multiple of radian.</skos:example>
    <skos:definition>The exponent of radian in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A110"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A297">
    <owl:unionOf rdf:nodeID="A74"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A298">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A299"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A300">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/startDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A286">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/occursIn"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A301">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A302"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A303">
    <owl:unionOf rdf:nodeID="A304"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A225">
    <owl:intersectionOf rdf:nodeID="A265"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isFirstMemberOf">
    <skos:scopeNote>Given the Open World Assumption, the absence of a predecessor does not entail that an ordered member is the first member of an ordered collection. This property is used to explicitly indicate the first member. Since ordered collections need not be strictly ordered, there can be more than one first member.</skos:scopeNote>
    <skos:prefLabel>is first member of</skos:prefLabel>
    <skos:definition>Relates the first member of an ordered collection to the collection.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/OrderedCollection"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/OrderedMember"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/OrderedCollection">
    <skos:scopeNote>Includes partially ordered collections as well as collections in which members occupy the same position in a 'tie.' All members of an ordered collection are ordered members.</skos:scopeNote>
    <skos:prefLabel>Ordered Collection</skos:prefLabel>
    <skos:definition>A collection whose members are ordered in some way.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A305"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A278">
    <owl:intersectionOf rdf:nodeID="A8"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A173">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A199"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ContemporaryEvent">
    <skos:scopeNote>When the event actually ends, it will cease being contemporary.</skos:scopeNote>
    <skos:prefLabel>Contemporary Event</skos:prefLabel>
    <skos:definition>An event that has started but has not yet ended.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A306"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/plannedEndDateTime">
    <skos:scopeNote>This property, unlike gist:actualEndDateTime, does not have a subproperty for microsecond precision, because planned times typically are not expressed at that level of granularity. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual.</skos:scopeNote>
    <skos:scopeNote>This is an abstraction over the various precisions of planned end time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.</skos:scopeNote>
    <skos:prefLabel>planned end date time</skos:prefLabel>
    <skos:definition>The date that something is or was planned to end, with no implied precision.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/endDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A307">
    <rdf:rest rdf:nodeID="A308"/>
    <rdf:first rdf:nodeID="A226"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A309">
    <owl:someValuesFrom rdf:nodeID="A310"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isGovernedBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A209">
    <rdf:rest rdf:nodeID="A108"/>
    <rdf:first rdf:nodeID="A311"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A312">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A313">
    <owl:someValuesFrom rdf:nodeID="A46"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasGiver">
    <skos:scopeNote>This property is often used in abstract contexts such as agreements, obligations, contracts, etc., whereas gist:comesFromAgent is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another. However, there are contexts in which either may be appropriate, such as the giving of a gift.</skos:scopeNote>
    <skos:prefLabel>has giver</skos:prefLabel>
    <skos:example>An offer is made by a giver; an obligation has a giver who is obligated to another person; a gift is presented by the giver.</skos:example>
    <skos:definition>Relates something to the participant that provides it.</skos:definition>
    <owl:propertyDisjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasRecipient"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualStartMinute">
    <skos:scopeNote>Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.</skos:scopeNote>
    <skos:prefLabel>actual start minute</skos:prefLabel>
    <skos:example>'2021-06-01T08:32:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual date and time that something started, with precision of one minute.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A314">
    <owl:someValuesFrom rdf:nodeID="A170"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/sequence">
    <skos:prefLabel>sequence</skos:prefLabel>
    <skos:definition>For ordering ordered lists.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/TimeInterval">
    <skos:scopeNote>This is distinct from a duration, which describes how long a time interval lasts (e.g., one hour; 3 days; 22 minutes).</skos:scopeNote>
    <skos:scopeNote>An ongoing state of affairs with an unknown end time in the future cannot be a time interval; e.g. the lifespan of a living person cannot be a time interval, as the end time is unknown.</skos:scopeNote>
    <skos:prefLabel>Time Interval</skos:prefLabel>
    <skos:example>7pm to 9pm on Jan 1, 2001; fiscal year 2023 (according to some particular definition of fiscal year); the week starting at midnight of January 12, 2023 and lasting exactly 168 hours.</skos:example>
    <skos:definition>A span of time with a known start time, end time, and duration. As long as two of the three are known, the third can be inferred.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="A315"/>
    <rdfs:subClassOf rdf:nodeID="A316"/>
    <rdfs:subClassOf rdf:nodeID="A317"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A318">
    <rdf:rest rdf:nodeID="A307"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Collection"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A136">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A319"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isRenderedOn">
    <skos:prefLabel>is rendered on</skos:prefLabel>
    <skos:example>A document is rendered on a computer screen; a piece of music is rendered through speakers.</skos:example>
    <skos:definition>Relates content to the media on which it is rendered.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A320">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A321"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/TemporalRelation">
    <skos:scopeNote>A temporal relation must have a minimum of two participants. For example, both the employer and the employee are participants in a temporal relation representing a period of employment. Note that 'participant' does not imply agency; a non-sentient being can participate in a temporal relation. For example, both a person and a house could be participants in a hypothetical relation 'lives at.'</skos:scopeNote>
    <skos:prefLabel>Temporal Relation</skos:prefLabel>
    <skos:example>The relationship between a person and their employer; the relationship between a person or business and an address.</skos:example>
    <skos:definition>A relationship existing for a period of time.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="A322"/>
    <rdfs:subClassOf rdf:nodeID="A300"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A98">
    <rdf:rest rdf:nodeID="A323"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Template"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasAddress">
    <skos:prefLabel>has address</skos:prefLabel>
    <skos:example>A brick-and-mortar store has a street address; a person can be contacted electronically via an email address.</skos:example>
    <skos:definition>Relates something to its physical or electronic address.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Address"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A233">
    <rdf:rest rdf:nodeID="A324"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualStartDateTime">
    <skos:scopeNote>This is an abstraction over the various precisions of actual start time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.</skos:scopeNote>
    <skos:prefLabel>actual start date time</skos:prefLabel>
    <skos:definition>The actual date and time that something started, with no implied precision.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/startDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A325">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A326">
    <owl:unionOf rdf:nodeID="A246"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A327">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A328"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/comesFromAgent">
    <skos:scopeNote>This property is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another, whereas gist:hasGiver is typically used in more abstract contexts such as agreements, obligations, contracts, etc. However, there are contexts in which either may be appropriate, such as the giving of a gift.</skos:scopeNote>
    <skos:scopeNote>This is not the inverse of gist:goesToAgent, as both properties have the message or shipment as the subject.</skos:scopeNote>
    <skos:prefLabel>comes from agent</skos:prefLabel>
    <skos:example>A package is shipped by a person; a purchase order is emailed to a vendor by an organization.</skos:example>
    <skos:definition>Relates something to the originating agent.</skos:definition>
    <rdfs:range rdf:nodeID="A303"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A329">
    <owl:intersectionOf rdf:nodeID="A330"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A331">
    <owl:intersectionOf rdf:nodeID="A332"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A322">
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minCardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A333">
    <rdf:rest rdf:nodeID="A195"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A334">
    <rdf:rest rdf:nodeID="A335"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A336">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A224"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Determination">
    <skos:prefLabel>Determination</skos:prefLabel>
    <skos:example>Measuring the sulphur content of crude oil; evaluating a loan application for approval; estimating the price of gas for the next three months; determining whether and by how much an interest rate should change; classifying a purchase into a budget category.</skos:example>
    <skos:definition>An event whose purpose is to establish a specific result, value, or outcome, usually by research, measuring, evaluating, or calculating.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A337">
    <owl:unionOf rdf:nodeID="A338"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A339">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/containedText"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance">
    <skos:scopeNote>This concept generally corresponds to mass nouns in English. By contrast, instances of PhysicalIdentifiableItem, such as a computer, book, or car, are count nouns. PhysicalIdentifiableItems are made up of PhysicalSubstances; e.g., a cake is made up of butter, flour, and sugar; a ring is made of gold. If you divide a PhysicalSubstance such as an amount of water into parts, you have different amounts of water otherwise indistinguishable from one another; if you divide a PhysicalIdentifiableItem such as a computer into parts, each part will be distinguishable from the original whole.</skos:scopeNote>
    <skos:scopeNote>An instance of this class has weight and takes up space. We mean the physical gold in a ring, not the concept of gold that shows up in the periodic table. The latter would be an instance of gist:KnowledgeConcept.</skos:scopeNote>
    <skos:prefLabel>Physical Substance</skos:prefLabel>
    <skos:example>Negative example: the concept of gold.</skos:example>
    <skos:example>An amount of water, penicillin, sand, or gold.</skos:example>
    <skos:definition>An undifferentiated amount of physical material which, when subdivided, results in each part being indistinguishable in nature from the whole and from every other part.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <rdfs:subClassOf rdf:nodeID="A57"/>
    <rdfs:subClassOf rdf:nodeID="A340"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A256">
    <rdf:rest rdf:nodeID="A341"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A157">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isDirectPartOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasBroader">
    <skos:prefLabel>has broader</skos:prefLabel>
    <skos:example>The aspect distance is broader than the aspect height.</skos:example>
    <skos:definition>Relates a thing to another thing with a broader meaning.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/deathDate">
    <skos:scopeNote>Refers to a calendar date and is assumed to have precision of one day (time zone offset is allowed). Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Implementations requiring a death date to the minute can define a subproperty.</skos:scopeNote>
    <skos:prefLabel>death date</skos:prefLabel>
    <skos:example>'2021-06-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The date some living thing died.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/data/gist/_Aspect_duration">
    <skos:prefLabel>duration</skos:prefLabel>
    <skos:editorialNote>This instance has been duplicated from reference data so it can be used in property restrictions.</skos:editorialNote>
    <skos:definition>The aspect duration.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A279">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A63">
    <owl:someValuesFrom rdf:nodeID="A84"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasGiver"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ScheduledEvent">
    <skos:scopeNote>If the event already started, but has not yet ended, it is a contemporary event with an actual start datetime. If the event is over, it is a historical event having an actual end datetime. The event always retains its planned start datetime, and thus continues to be a scheduled event.</skos:scopeNote>
    <skos:prefLabel>Scheduled Event</skos:prefLabel>
    <skos:definition>An event with a planned start datetime.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A139"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A342">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ContractTerm">
    <skos:prefLabel>Contract Term</skos:prefLabel>
    <skos:definition>A specification of some aspect of a contract.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Specification"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasUnitOfMeasure">
    <skos:prefLabel>has unit of measure</skos:prefLabel>
    <skos:example>The magnitude 87 inches of height has unit of measure inches.</skos:example>
    <skos:definition>Relates a magnitude to its unit of measure.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A205">
    <owl:someValuesFrom rdf:nodeID="A212"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/comesFromAgent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A202">
    <owl:intersectionOf rdf:nodeID="A89"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/longitude">
    <skos:prefLabel>longitude</skos:prefLabel>
    <skos:definition>Degrees from the prime meridian.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoPoint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A317">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/endDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A343">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ontology/gistCore">
    <gist:license rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://creativecommons.org/licenses/by/4.0/</gist:license>
    <skos:prefLabel>gist</skos:prefLabel>
    <skos:historyNote>&#xD;
		gist 13.0.0 released 2024-Jul-24.&#xD;
        gist 12.1.0 released 2024-Feb-27.&#xD;
        gist 12.0.1 released 2023-Jul-28.&#xD;
        gist 12.0.0 released 2023-Jul-05.&#xD;
        gist 11.1.0 released 2022-Oct-10.&#xD;
        gist 11.0.0 released 2022-Apr-11.&#xD;
	</skos:historyNote>
    <skos:definition>gist is a minimalist upper ontology created by Semantic Arts.</skos:definition>
    <owl:versionIRI rdf:resource="https://w3id.org/semanticarts/ontology/gistCoreX.x.x"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isRecordedAt">
    <skos:scopeNote>Precision may vary according to context.</skos:scopeNote>
    <skos:prefLabel>is recorded at</skos:prefLabel>
    <skos:example>The date and time a customer payment or stock purchase was posted.</skos:example>
    <skos:definition>The date that something was posted (which is not necessarily the date it occurred). It must be after the date of occurrence, but could be before or after the planned date.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/atDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure">
    <skos:prefLabel>Unit of Measure</skos:prefLabel>
    <skos:example>An acre is a unit for measuring area.</skos:example>
    <skos:definition>A standard amount used to measure or specify things.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/GeoRegion">
    <skos:scopeNote>A geographic region could be non-contiguous; e.g., the region governed by the US federal government is the contiguous area of the lower 48 states plus Alaska, Hawaii, and overseas territories. Child classes in lower ontologies can make this distinction.</skos:scopeNote>
    <skos:prefLabel>Geographic Region</skos:prefLabel>
    <skos:example>The bounded shape that defines the region occupied by Crater Lake; the bounded area known as the contiguous USA.</skos:example>
    <skos:definition>A bounded region (or set of regions) on the surface of the Earth.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Template"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Language"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/IntellectualProperty"/>
    <rdfs:subClassOf rdf:nodeID="A344"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A345">
    <rdf:rest rdf:nodeID="A22"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#byte"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A280">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualEndYear">
    <skos:scopeNote>Used for things where the precision of a year is sufficient. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included.</skos:scopeNote>
    <skos:prefLabel>actual end year</skos:prefLabel>
    <skos:example>The tenure of the previous chairman of the board ended in 2021.</skos:example>
    <skos:example>'2021-01-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual date that something ended, with precision of one year.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A346">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A347">
    <owl:unionOf rdf:nodeID="A348"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#editorialNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Behavior">
    <skos:prefLabel>Behavior</skos:prefLabel>
    <skos:example>Drilling and cutting are two different kinds of manufacturing event.</skos:example>
    <skos:definition>A category indicating the nature of an activity.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/GeoPoint">
    <skos:prefLabel>Geographic Point</skos:prefLabel>
    <skos:definition>An individual point on or above the Earth's surface, identified by latitude, longitude and altitude. Altitude is the distance measured from sea level. If altitude is missing, the point is assumed to be at the Earth's surface. These points are described using decimal latitude/longitude.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A261"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Language"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/IntellectualProperty"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A328">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/birthDate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A34">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A48"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A251">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Component"/>
    <owl:onProperty rdf:nodeID="A271"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A349">
    <owl:unionOf rdf:nodeID="A150"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A268">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/NetworkNode"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A321">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Behavior"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/prevents"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A101">
    <rdf:rest rdf:nodeID="A99"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/precedes">
    <skos:scopeNote>Typically this predicate would be used asymmetricallly and irreflexively, but the ontology does not formalize this.</skos:scopeNote>
    <skos:scopeNote>This is the transitive version of gist:precedesDirectly.</skos:scopeNote>
    <skos:scopeNote>The less-than symbol is often used to represent this relation.</skos:scopeNote>
    <skos:prefLabel>precedes</skos:prefLabel>
    <skos:definition>A generic ordering relation indicating that the subject comes before the object.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ContingentObligation">
    <skos:scopeNote>A contingent obligation might have a getter counterparty (as in the case of insurance); but it might not (as in the case of an offer).</skos:scopeNote>
    <skos:prefLabel>Contingent Obligation</skos:prefLabel>
    <skos:definition>An obligation that is not yet firm. There is some contingent event whose occurrence will cause the obligation to become firm.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A242"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A350">
    <owl:unionOf rdf:nodeID="A345"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isProducedBy">
    <skos:prefLabel>is produced by</skos:prefLabel>
    <skos:example>A painting is produced by a person.</skos:example>
    <skos:example>A measurement is produced by a sensor.</skos:example>
    <skos:example>A deliverable is produces by a task.</skos:example>
    <skos:definition>Relates something to the thing that created, composed, or brought it into existence.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A351">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A352"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A353">
    <owl:intersectionOf rdf:nodeID="A354"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A355">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A356"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Tag">
    <skos:scopeNote>Whether to use gist:containedText or gist:uniqueText on tags is an implementation decision. Since the latter is a subproperty of the former, the restriction remains valid either way.</skos:scopeNote>
    <skos:prefLabel>Tag</skos:prefLabel>
    <skos:definition>A term in a folksonomy used to categorize things. Tags can be made up on the fly by users.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="A15"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A68">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasGiver"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasSubtrahend">
    <skos:scopeNote>Commonly used with financial metrics.</skos:scopeNote>
    <skos:prefLabel>has subtrahend</skos:prefLabel>
    <skos:example>In the equation 'profit = revenue - expenses', revenue is an addend and expenses is a subtrahend.</skos:example>
    <skos:definition>Relates an aspect to another aspect that is a subtracted component of it.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A357">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/ProductCategory"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isCategorizedBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A67">
    <rdf:rest rdf:nodeID="A153"/>
    <rdf:first rdf:nodeID="A176"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Person">
    <skos:prefLabel>Person</skos:prefLabel>
    <skos:example>Negative example: fictional characters.</skos:example>
    <skos:definition>A human being who was or is alive.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A358"/>
    <rdfs:subClassOf rdf:nodeID="A359"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A352">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Behavior"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/allows"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A304">
    <rdf:rest rdf:nodeID="A360"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A361">
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Commitment"/>
    <owl:onProperty rdf:nodeID="A41"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A362">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/EquipmentType"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isCategorizedBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A363">
    <rdf:rest rdf:nodeID="A281"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GovernedGeoRegion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A364">
    <rdf:rest rdf:nodeID="A351"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/GovernedGeoRegion">
    <skos:scopeNote>Geographic regions do not need not be physically contiguous in order to constitute a governed geographic region; e.g., Alaska and Hawaii are part of the region governed by the United States.</skos:scopeNote>
    <skos:prefLabel>Governed Geographic Region</skos:prefLabel>
    <skos:definition>A geographic region governed by at least one government organization.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A365"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A366">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasUnitOfMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A299">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasGoal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A367">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A180"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isGeoContainedIn">
    <skos:prefLabel>is geographically contained in</skos:prefLabel>
    <skos:definition>Relates one geographic location to another that contains it.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A368">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/LivingThing"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasBiologicalParent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A369">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A147"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A370">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A371"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A372">
    <owl:someValuesFrom rdf:nodeID="A164"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasParty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A360">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A294">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:cardinality>
    <owl:onProperty rdf:nodeID="A373"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A113">
    <rdf:rest rdf:nodeID="A269"/>
    <rdf:first rdf:nodeID="A374"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isDirectPartOf">
    <skos:scopeNote>It is safest to use this property when semantic directness is inherent in the relationship, rather than simply expressing a chosen granularity. For example, a spark plug is a direct part of an engine block; there cannot be any intermediate parts. Otherwise, there is a risk of making an isDirectPartOf assertion and then later inserting an intermediate part; this will result in making an asserted triple false even though there was no change in the world. When in doubt, use the transitive version gist:isPartOf.</skos:scopeNote>
    <skos:scopeNote>Because the part has independent existence, there is no cascading delete.</skos:scopeNote>
    <skos:prefLabel>is direct part of</skos:prefLabel>
    <skos:definition>The relationship between a part and a whole where the part has independent existence and there are no other parts in between.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isPartOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A272">
    <owl:intersectionOf rdf:nodeID="A375"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A240">
    <owl:unionOf rdf:nodeID="A376"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDate">
    <skos:scopeNote>Used for anything with a planned start date, such as when a lease will start, when a configuration becomes available, etc. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision.</skos:scopeNote>
    <skos:prefLabel>planned start date</skos:prefLabel>
    <skos:example>'2021-06-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The date that something is or was planned to start, with precision of one day.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasUniqueBroader">
    <skos:prefLabel>has unique broader</skos:prefLabel>
    <skos:definition>Relates a thing to a unique other thing with a broader meaning.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasBroader"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A241">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/uniqueText"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasDivisor">
    <skos:scopeNote>Provides a supplemental method of decomposing a unit of measure or an aspect into component factors. Enables dimensional analysis such as miles per hour x hours = miles.</skos:scopeNote>
    <skos:prefLabel>has divisor</skos:prefLabel>
    <skos:example>Miles per hour has miles as a multiplier and hour as a divisor; speed has distance as a multiplier and duration as a divisor.</skos:example>
    <skos:definition>Relates a unit of measure to another unit of measure that is a divisor, or relates an aspect to another aspect that is a divisor.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/linksTo">
    <gist:rangeIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/NetworkNode"/>
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/NetworkLink"/>
    <skos:prefLabel>links to</skos:prefLabel>
    <skos:definition>Relates a network link to its destination network node. Unlike the superproperty, this represents a directed connection.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/links"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A377">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isGovernedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Address">
    <skos:prefLabel>Address</skos:prefLabel>
    <skos:example>A PO Box, a URL to a PDF file.</skos:example>
    <skos:definition>A reference to a place (real or virtual) that can be located by some routing algorithm and where messages or things can be sent or received.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Content"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A11">
    <rdf:rest rdf:nodeID="A378"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentOf">
    <gist:rangeIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
    <gist:rangeIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <gist:rangeIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/IntellectualProperty"/>
    <gist:rangeIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Equipment"/>
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Assignment"/>
    <skos:scopeNote>While typically this predicate will be used with assignment subjects, there may be other use cases, and therefore a domain is not specified.</skos:scopeNote>
    <skos:scopeNote>People, organizations, monetary amounts, equipment can all be assigned.</skos:scopeNote>
    <skos:prefLabel>is assignment of</skos:prefLabel>
    <skos:example>Assignment of a person to a project.</skos:example>
    <skos:definition>Relates an assignment to the resource it assigns.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A379">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A380"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/data/gist/_Aspect_area">
    <skos:prefLabel>area</skos:prefLabel>
    <skos:editorialNote>This instance has been duplicated from reference data so it can be used in property restrictions.</skos:editorialNote>
    <skos:definition>The aspect area.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/refersTo">
    <skos:prefLabel>refers to</skos:prefLabel>
    <skos:definition>Relates something to another resource that it points to, indicates, or references.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isConnectedTo">
    <skos:prefLabel>is connected to</skos:prefLabel>
    <skos:definition>A non-owning, non-causal, non-subordinate (i.e., peer-to-peer) relationship.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/LivingThing">
    <skos:scopeNote>Not all life forms have exactly two parents, so the restriction only specifies a minimum of one.</skos:scopeNote>
    <skos:prefLabel>Living Thing</skos:prefLabel>
    <skos:example>Negative examples: fictional life forms such as unicorns or Mickey Mouse.</skos:example>
    <skos:example>A cat, a mushroom, a tree.</skos:example>
    <skos:definition>Something that is currently, or at some point in time was, alive.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A381"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A245">
    <owl:unionOf rdf:nodeID="A117"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem">
    <skos:scopeNote>This concept generally corresponds to count nouns in English. By contrast, physical substances, such as an amount of water, flour, or sand, are mass nouns. Physical identifiable items are made up of physical substances; e.g., a cake is made up of butter, flour, and sugar; a statue is made of bronze. If you divide a physical substance such as an amount of water into parts, you have two amounts of water otherwise indistinguishable from one another; if you divide a physical identifiable item such as a computer into parts, each part is different from the whole.</skos:scopeNote>
    <skos:prefLabel>Physical Identifiable Item</skos:prefLabel>
    <skos:example>A computer, a book, a car.</skos:example>
    <skos:definition>A discrete physical object which, if subdivided, will result in parts that are distinguishable in nature from the whole and in general also from the other parts.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/SchemaMetaData"/>
    <rdfs:subClassOf rdf:nodeID="A382"/>
    <rdfs:subClassOf rdf:nodeID="A314"/>
    <rdfs:subClassOf rdf:nodeID="A69"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/IntergovernmentalOrganization">
    <skos:prefLabel>Intergovernmental Organization</skos:prefLabel>
    <skos:example>The United Nations, the European Union, the Metropolitan Transit Authority.</skos:example>
    <skos:definition>An organization whose members are government organizations. This can comprise regional, municipal, state/province, or national level entities.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A383"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude">
    <skos:prefLabel>has magnitude</skos:prefLabel>
    <skos:example>A car or model of car has magnitudes for length, width, weight, average miles per gallon, etc.</skos:example>
    <skos:definition>Relates a thing to a magnitude.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasDirectBroader">
    <skos:scopeNote>Unlike gist:hasBroader, this property is not transitive. It is safest to use this property when semantic directness is inherent in the relationship. Otherwise, there is a risk of making a hasDirectBroader assertion and then later inserting an intermediate part; this will result in making an asserted triple false even though there was no change in the world. When in doubt, use the transitive version gist:hasBroader.</skos:scopeNote>
    <skos:prefLabel>has direct broader</skos:prefLabel>
    <skos:definition>Relates a thing to another thing with a broader meaning, when there is no intermediate between them.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasBroader"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Event">
    <skos:scopeNote>An event occurs during a time interval, which is distinct from the event.</skos:scopeNote>
    <skos:scopeNote>An event does not necessarily have either planned or actual start or end datetimes. For example, a conference can be in the planning phase without any dates selected, but is nevertheless an (unscheduled) event. The subclasses of gist:Event state particular restrictions on planned and actual start and end dates.</skos:scopeNote>
    <skos:prefLabel>Event</skos:prefLabel>
    <skos:example>A transaction, conference, baseball game, earthquake.</skos:example>
    <skos:definition>Something that occurs over a period of time, often characterized as an activity being carried out by some person, organization, or software application or brought about by natural forces.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/TimeInterval"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Language"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasParty">
    <skos:scopeNote>Subproperties may be defined to describe specific parties, such as hasLender and hasBorrower for a loan.</skos:scopeNote>
    <skos:prefLabel>has party</skos:prefLabel>
    <skos:example>Loan agreements have lender and borrower parties.</skos:example>
    <skos:definition>Relates an event, agreement, or obligation to a participating person or organization.</skos:definition>
    <rdfs:range rdf:nodeID="A291"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A194">
    <owl:unionOf rdf:nodeID="A334"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation">
    <skos:scopeNote>A geographic location may be a point, region, or volume.</skos:scopeNote>
    <skos:prefLabel>Geographic Location</skos:prefLabel>
    <skos:definition>A physical location, with the earth as a frame of reference.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A384">
    <owl:someValuesFrom rdf:nodeID="A121"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfAmpere">
    <skos:prefLabel>exponent of ampere</skos:prefLabel>
    <skos:example>In the equation '1 milliampere = 0.001 x ampere'&#xD;
&#xD;
		the conversionFactor for milliampere is 0.001&#xD;
		the exponent of ampere is 1&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing milliampere must be a multiple of ampere.</skos:example>
    <skos:definition>The exponent of ampere in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A337"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/description">
    <skos:scopeNote>This property is used to describe instance data which is not part of the ontology. A definition and a description have different semantics. Use skos:definition for a statement of the meaning of a thing and gist:description to describe a thing's attributes, characteristics, or features.</skos:scopeNote>
    <skos:prefLabel>description</skos:prefLabel>
    <skos:example>A person does not have a definition, but might be described as being six feet tall with brown hair and blue eyes; an ontology class or taxonomy term has a definition.</skos:example>
    <skos:example>'The Empire State Building is a 102-story Art Deco skyscraper in midtown Manhattan in New York City. It was designed by Shreve, Lamb &amp; Harmon and built from 1930 to 1931.'</skos:example>
    <skos:definition>A statement about someone or something's attributes or characteristics.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A385">
    <owl:intersectionOf rdf:nodeID="A172"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A386">
    <owl:intersectionOf rdf:nodeID="A387"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A388">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A387">
    <rdf:rest rdf:nodeID="A285"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A389">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A262">
    <rdf:rest rdf:nodeID="A16"/>
    <rdf:first rdf:nodeID="A390"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isSupersededBy">
    <skos:prefLabel>is superseded by</skos:prefLabel>
    <skos:example>gist:connectedTo was superseded by gist:isConnectedTo (renaming with no semantic change).</skos:example>
    <skos:definition>Relates a deprecated term to a term that replaces it, which is either an exact (in the case of simple renaming) or approximate (in the case of renaming and some semantic change) semantic match.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfOther">
    <skos:scopeNote>Set the value to 0 if the units of measure in the unit group can be expressed using the standard set of exponents (as in the examples).&#xD;
&#xD;
		Otherwise set the value to 1, which typically means the units of measure in the group use a logarithmic scale.</skos:scopeNote>
    <skos:prefLabel>exponent of other</skos:prefLabel>
    <skos:example>Decibel, pH, and octave are units of measure that are logarithmic. Their unit groups have exponent of other = 1.</skos:example>
    <skos:definition>Indicates whether a unit of measure can be expressed in terms of the standard exponents (as shown in the examples).</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A391"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A392">
    <rdf:rest rdf:nodeID="A393"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A83">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A394">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://www.w3.org/2002/07/owl#real"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A358">
    <owl:intersectionOf rdf:nodeID="A276"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Requirement">
    <skos:prefLabel>Requirement</skos:prefLabel>
    <skos:example>In the US, drivers must drive on the right side of the road.</skos:example>
    <skos:definition>The obligation of a person or organization to behave in a certain way.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A395">
    <rdf:rest rdf:nodeID="A396"/>
    <rdf:first rdf:nodeID="A397"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant">
    <skos:scopeNote>This will most often be used as an abstract property. Use subproperties that indicate the nature of the participation (e.g. hasBorrower, hasVenue).</skos:scopeNote>
    <skos:scopeNote>The thing with participants will often be an agreement, event or obligation. Participation does not imply agency.</skos:scopeNote>
    <skos:prefLabel>has participant</skos:prefLabel>
    <skos:example>An event of transferring money has a participating account that receives the money.</skos:example>
    <skos:definition>Relates something (e.g. an agreement) to things that play a role, or take part or are otherwise involved in some way.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A229">
    <rdf:rest rdf:nodeID="A312"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A274">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A398"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A73">
    <owl:someValuesFrom rdf:nodeID="A347"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isAllocatedBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/NetworkLink">
    <skos:scopeNote>Each newtork link is connected to a network node via the property gist:links or one of its subproperties.</skos:scopeNote>
    <skos:prefLabel>Network Link</skos:prefLabel>
    <skos:example>A network link may be physical, such as pipes, wired or wireless networks, but may also be a link in a non-physical network, such as organizational structures or social networks.</skos:example>
    <skos:definition>An abstract representation of the connection between two or more nodes in a network.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A399"/>
    <rdfs:subClassOf rdf:nodeID="A188"/>
    <rdfs:subClassOf rdf:nodeID="A400"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#scopeNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A72">
    <rdf:rest rdf:nodeID="A92"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Component"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A401">
    <rdf:rest rdf:nodeID="A402"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/OrderedCollection"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A227">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/refersTo"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A403">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A404"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A310">
    <owl:unionOf rdf:nodeID="A392"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A13">
    <owl:someValuesFrom rdf:nodeID="A235"/>
    <owl:onProperty rdf:nodeID="A124"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A155">
    <rdf:rest rdf:nodeID="A405"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/endDateTime">
    <skos:scopeNote>Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.</skos:scopeNote>
    <skos:scopeNote>This property is neutral along two dimensions: precision (e.g., day, second, millisecond) and actual vs. planned. As such, it will generally not be asserted directly except in special cases (e.g., for time intervals).</skos:scopeNote>
    <skos:prefLabel>end date time</skos:prefLabel>
    <skos:definition>The date and time that something ends.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/atDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalEvent">
    <skos:prefLabel>Physical Event</skos:prefLabel>
    <skos:example>Negative examples: Excludes events that have no meaningful location, such as financial events or project milestones.</skos:example>
    <skos:example>A meeting, a car accident.</skos:example>
    <skos:definition>An event that can be said to have occurred at some place in space.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A386"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/OrderedMember">
    <skos:scopeNote>An ordered member points to the real world item via the providesOrderFor property. Ordering information is represented either as a number in a sequence, or by preceding or following another ordered member.</skos:scopeNote>
    <skos:prefLabel>Ordered Member</skos:prefLabel>
    <skos:example>A person may rank 12th in the Boston Marathon but 29th in the New York City Marathon.</skos:example>
    <skos:definition>A member of an ordered collection serving as a proxy for a real world item, which can appear in different orders in different collections. The ordered member appears in exactly one ordered collection.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A71"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A399">
    <owl:intersectionOf rdf:nodeID="A169"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A198">
    <owl:hasValue rdf:resource="https://w3id.org/semanticarts/ns/data/gist/_Aspect_mass"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup">
    <skos:scopeNote>Typically there is one unit group per aspect. An example of an aspect with two unit groups is vehicle efficiency, which can be measured by miles per gallon (distance per volume) or by liters per 100 kilometers (volume per distance). These two units of measure need to be in different unit groups because they have different values of exponents. When adding a unit of measure to a unit group, make sure it has the same exponents as the other members of the unit group.</skos:scopeNote>
    <skos:prefLabel>Unit Group</skos:prefLabel>
    <skos:example>The units of measure bit, byte, kilobit, kilobyte, etc. are all in the same unit group because they can all be used to measure an amount of data.</skos:example>
    <skos:definition>A collection of units of measure that can all be used to measure the same aspects.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <rdfs:subClassOf rdf:nodeID="A406"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Collection"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A163">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/longitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualStartDate">
    <skos:scopeNote>Used for things where the precision of a date is sufficient, such as most projects, tasks, and the like. Recommended usage is to zero out the hours through microseconds to avoid spurious precision.</skos:scopeNote>
    <skos:prefLabel>actual start date</skos:prefLabel>
    <skos:example>'2021-06-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual date that something started, with precision of one day.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A282">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/CountryGovernment"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isGovernedBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ControlledVocabulary">
    <skos:scopeNote>A controlled vocabulary is similar to a skos:ConceptScheme, but it could also be used for things that are not concepts, such as organizations, US presidents, geographic regions, etc. Hierarchical relationships between instances of the controlled vocabulary are possible.</skos:scopeNote>
    <skos:prefLabel>Controlled Vocabulary</skos:prefLabel>
    <skos:definition>A collection of terms approved and managed by some organization or person.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A142"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A407">
    <rdf:rest rdf:nodeID="A369"/>
    <rdf:first rdf:nodeID="A309"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A408">
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GovernmentOrganization"/>
    <owl:onProperty rdf:nodeID="A207"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A107">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Network"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A148">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A302">
    <owl:someValuesFrom rdf:nodeID="A409"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A410">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A44"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfNumber">
    <skos:scopeNote>Use when the unit of measure involves a count or other number.</skos:scopeNote>
    <skos:prefLabel>exponent of number</skos:prefLabel>
    <skos:example>In the equation '1 beat per minute = 0.016667 x number per second'&#xD;
&#xD;
		the conversion factor for beat per minute is 0.016667&#xD;
		the exponent of number is 1&#xD;
		the exponent of second is -1&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing beat per minute must be a multiple of number per second.</skos:example>
    <skos:definition>The exponent of number in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A349"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A411">
    <rdf:rest rdf:nodeID="A412"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ProductCategory">
    <skos:prefLabel>Product Category</skos:prefLabel>
    <skos:example>Automobile models, NATO product codes.</skos:example>
    <skos:definition>Any of many ways of categorizing products.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A7">
    <rdf:rest rdf:nodeID="A413"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#nonPositiveInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/System">
    <skos:prefLabel>System</skos:prefLabel>
    <skos:definition>A composite with component parts that contribute to the goal of the system.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A174"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A75">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A414">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A415">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A91"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A376">
    <rdf:rest rdf:nodeID="A160"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A416">
    <rdf:rest rdf:nodeID="A379"/>
    <rdf:first rdf:nodeID="A366"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ContingentEvent">
    <skos:prefLabel>Contingent Event</skos:prefLabel>
    <skos:example>A fire insurance payout is contingent on a particular building burning down; selling 20 shares of stock in a given company is contingent on the price dropping below $200/share; the death benefit payout on a life insurance policy is contingent on the death of the insured person.</skos:example>
    <skos:definition>An event with a probability of happening in the future, and usually dependent upon some other event or condition.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A417"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A371">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GovernmentOrganization"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isUnderJurisdictionOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A192">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A408"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A365">
    <owl:intersectionOf rdf:nodeID="A289"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A221">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A96">
    <rdf:rest rdf:nodeID="A12"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Composite"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A154">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentTo"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A43">
    <rdf:rest rdf:nodeID="A273"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GovernmentOrganization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A138">
    <owl:hasValue rdf:resource="https://w3id.org/semanticarts/ns/data/gist/_Aspect_volume"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDateTime">
    <skos:scopeNote>This property, unlike gist:actualStartDateTime, does not have a subproperty for microsecond precision, because planned times typically are not expressed at that level of granularity. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual.</skos:scopeNote>
    <skos:scopeNote>This is an abstraction over the various precisions of planned start time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.</skos:scopeNote>
    <skos:prefLabel>planned start date time</skos:prefLabel>
    <skos:definition>The date and time that something is or was planned to start, with no implied precision.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/startDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A4">
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/CountryGeoRegion"/>
    <owl:onProperty rdf:nodeID="A377"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#historyNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A133">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Language"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isExpressedIn"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A182">
    <owl:intersectionOf rdf:nodeID="A364"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Discipline">
    <skos:prefLabel>Discipline</skos:prefLabel>
    <skos:example>Finance, accounting, project management, acoustics, ballistics.</skos:example>
    <skos:definition>An area of study or practice.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A413">
    <rdf:rest rdf:nodeID="A80"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A418">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A357"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfSteradian">
    <skos:scopeNote>Steradian is a measure of solid angle.</skos:scopeNote>
    <skos:prefLabel>exponent of steradian</skos:prefLabel>
    <skos:example>In the equation '1 watt per square meter steradian = 1 x kilogram per secondCubed steradian'&#xD;
&#xD;
		the conversion factor for watt per square meter steradian is 1&#xD;
		the exponent of kilogram is 1&#xD;
		the exponent of second is -3&#xD;
		the exponent of steradian is -1&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing watt per square meter steradian must a multiple of kilogram per secondCubed steradian.</skos:example>
    <skos:definition>The exponent of steradian in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A130"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Language">
    <skos:prefLabel>Language</skos:prefLabel>
    <skos:example>Natural languages such as English and Spanish; computer languages such as OWL, Python, and XML.</skos:example>
    <skos:definition>A recognized, organized set of symbols and grammar.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Building">
    <skos:scopeNote>User discretion can be applied to edge cases: e.g., is a traditional yurt 'relatively permanently situated' although it is portable and has a tent-like construction?</skos:scopeNote>
    <skos:prefLabel>Building</skos:prefLabel>
    <skos:example>Negative examples: houseboats (not built on land), caves (not man-made), food trucks and RVs (not permanently situated).</skos:example>
    <skos:example>A house, school, store, factory, chicken coop.</skos:example>
    <skos:definition>A relatively permanent man-made structure situated on a plot of land, having a roof and walls, commonly used for dwelling, entertaining, or working.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Landmark"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/goesToAgent">
    <skos:scopeNote>This property is intended to describe the physical or electronic transfer of something, such as a package or email, from one agent to another, whereas gist:hasRecipient is typically used in more abstract contexts such as agreements, obligations, contracts, etc. However, there are contexts in which either may be appropriate, such as the recieving of a gift.</skos:scopeNote>
    <skos:scopeNote>This is not the inverse of gist:comesFromAgent, as both properties have the message or shipment as the subject.</skos:scopeNote>
    <skos:prefLabel>goes to agent</skos:prefLabel>
    <skos:example>A package is sent to a person; a purchase order email is received by a vendor.</skos:example>
    <skos:definition>Relates something to the agent that receives it.</skos:definition>
    <rdfs:range rdf:nodeID="A419"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A390">
    <owl:someValuesFrom rdf:nodeID="A420"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A338">
    <rdf:rest rdf:nodeID="A208"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A253">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/plannedEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/DegreeOfCommitment">
    <skos:prefLabel>Degree Of Commitment</skos:prefLabel>
    <skos:example>A car rental typically has a lower degree of commitment than an airfare reservation.</skos:example>
    <skos:definition>The difficulty of reversing a commitment.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A311">
    <owl:allValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/OrderedCollection"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Collection">
    <skos:scopeNote>Individuals are placed in the collection using the gist:isMemberOf property. Collections typically are created because the members are functionally connected in some way. This definition allows a collection to have zero members.</skos:scopeNote>
    <skos:prefLabel>Collection</skos:prefLabel>
    <skos:example>A jury is a group of people; a financial ledger is a collection of transaction entries; a route is an (ordered) collection of segments.</skos:example>
    <skos:definition>A grouping of things.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Composite"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasBiologicalParent">
    <skos:prefLabel>has biological parent</skos:prefLabel>
    <skos:definition>Relates a living thing to its biological parent.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/LivingThing"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/LivingThing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A201">
    <owl:hasValue rdf:resource="https://w3id.org/semanticarts/ns/data/gist/_Aspect_duration"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A90">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A362"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A308">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A421"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A243">
    <rdf:rest rdf:nodeID="A35"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Commitment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/birthDate">
    <skos:scopeNote>This is a subproperty of gist:startDateTime rather than gist:actualStartDate because some living things have yet to be born. This property refers to a calendar date and is assumed to precision of one day (time zone offset is allowed). It is recommended to zero out the hours through microseconds to avoid spurious precision. Implementations requiring a birthdate to the minute can define a subproperty.</skos:scopeNote>
    <skos:prefLabel>birth date</skos:prefLabel>
    <skos:example>'2021-06-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The date some living thing was or will be born, with precision of one day.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/startDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A21">
    <rdf:rest rdf:nodeID="A298"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A106">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A422"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A423">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/OrderedMember"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/precedesDirectly"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A196">
    <owl:hasValue rdf:resource="https://w3id.org/semanticarts/ns/data/gist/_Aspect_altitude"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/numericValue">
    <skos:prefLabel>numeric value</skos:prefLabel>
    <skos:definition>The actual value of a magnitude.</skos:definition>
    <rdfs:range rdf:nodeID="A350"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A396">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A232"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/plannedStartYear">
    <skos:scopeNote>Used for anything with a planned start date where precision of one year is sufficient. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included.</skos:scopeNote>
    <skos:prefLabel>planned start year</skos:prefLabel>
    <skos:example>The automobile manufacturer announced that its full line-up will include only electric cars starting in 2035.</skos:example>
    <skos:example>'2021-01-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The date that something is or was planned to start, with precision of one year.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A378">
    <rdf:rest rdf:nodeID="A424"/>
    <rdf:first rdf:nodeID="A372"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Component">
    <skos:scopeNote>This is an abstract class that is not directly instantiated. Users will define subclasses that are meaningful to their domain of interest.</skos:scopeNote>
    <skos:scopeNote>This class is not disjoint with gist:Composite, because a component may itself break down into smaller components.</skos:scopeNote>
    <skos:scopeNote>Physical substances, such as ingredients in a cake batter, do not meet the independent existence criterion, so are not components.</skos:scopeNote>
    <skos:scopeNote>Many things are in a trivial sense a part of a larger thing, but are not considered components because they are not inherently part of that larger thing. For example, while a book may be part of a library (a collection of books), it is not inherently so, and thus is not a component. A playing card, on the other hand, could be considered a component in (member of) a deck of cards. This may be use case-dependent; e.g., car parts might be modeled as components in an automobile manufacturing context but not in a retail auto parts store.</skos:scopeNote>
    <skos:scopeNote>A component may be designed or intended as part of a whole without actually being so; e.g., a car steering wheel that is not installed in any car.</skos:scopeNote>
    <skos:prefLabel>Component</skos:prefLabel>
    <skos:definition>Something that, while having an independent existence, is inherently part of or designed to be part of a larger entity, such as a system or network.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A397">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/OrderedMember"/>
    <owl:onProperty rdf:nodeID="A267"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/uniqueText">
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Text"/>
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Tag"/>
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/MediaType"/>
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/ID"/>
    <skos:scopeNote>Note that the uniqueness only goes in one direction: a product catalog number might also be an employee ID.</skos:scopeNote>
    <skos:prefLabel>unique text</skos:prefLabel>
    <skos:example>The unique string for a vehicle identification number.</skos:example>
    <skos:definition>The unique string value of some content object, to be used when there is no possibility of having more than one value.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/containedText"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Content">
    <skos:scopeNote>Categories are not content until they are written down.</skos:scopeNote>
    <skos:prefLabel>Content</skos:prefLabel>
    <skos:example>A document, program, image.</skos:example>
    <skos:definition>Information available in some medium.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoRegion"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoPoint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/offersToReceive">
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Offer"/>
    <skos:scopeNote>This will most often be an amount of money, but could be anything of value, as in swaps.</skos:scopeNote>
    <skos:prefLabel>offers to receive</skos:prefLabel>
    <skos:example>A vendor makes an offer to receive a particular amount of money in exchange for the offered product; an offer to receive a home in exchange for an amount of money.</skos:example>
    <skos:definition>Relates an offer to the thing expected in return for the offered item.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isAllocatedBy">
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/ID"/>
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <skos:scopeNote>The allocator may be a person, organization, or automated process.</skos:scopeNote>
    <skos:prefLabel>is allocated by</skos:prefLabel>
    <skos:example>A U.S. Social Security number is allocated by the U.S. Social Security Administration; the media type https://www.iana.org/assignments/media-types/text/csv is allocated by the Internet Assigned Numbers Authority (IANA).</skos:example>
    <skos:definition>Relates something to whomever or whatever assigns or distributes it.</skos:definition>
    <rdfs:range rdf:nodeID="A425"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A120">
    <rdf:rest rdf:nodeID="A325"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Address"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualEndMinute">
    <skos:scopeNote>Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.</skos:scopeNote>
    <skos:prefLabel>actual end minute</skos:prefLabel>
    <skos:example>'2021-06-01T08:32:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual date and time that something ended, with precision of one minute.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A375">
    <rdf:rest rdf:nodeID="A426"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A3">
    <owl:intersectionOf rdf:nodeID="A33"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A427">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasBiologicalParent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A175">
    <rdf:rest rdf:nodeID="A250"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Composite"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/prevents">
    <skos:prefLabel>prevents</skos:prefLabel>
    <skos:example>A city ordinance prohibits jaywalking.</skos:example>
    <skos:definition>Relates an intention to behavior that it prohibits.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Behavior"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A422">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/NetworkNode"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/links"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A420">
    <owl:intersectionOf rdf:nodeID="A333"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A210">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/providesOrderFor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/data/gist/_Aspect_financial_balance">
    <skos:prefLabel>balance</skos:prefLabel>
    <skos:editorialNote>This instance has been duplicated from reference data so it can be used in property restrictions.</skos:editorialNote>
    <skos:definition>The aspect financial balance.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A428">
    <owl:intersectionOf rdf:nodeID="A429"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Offer">
    <skos:scopeNote>Dates on an offer represent the time period the offer is valid for, as in '25% off through October 25, 2025'.</skos:scopeNote>
    <skos:prefLabel>Offer</skos:prefLabel>
    <skos:example>An offer to sell a book for a given price; an offer to purchase real estate for a particular price; an offer to swap a sea kayak for a mountain bike; currency exchange. A donation may be modeled as an offer to receive money typically in exchange for $0.00, but sometimes for items of value such as coffee mugs or T-shirts.</skos:example>
    <skos:definition>A contingent commitment to buy, sell, swap or provide one or more described or identified goods or services in exchange for another (or others).</skos:definition>
    <owl:equivalentClass rdf:nodeID="A430"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A374">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/offersToProvide"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A296">
    <rdf:rest rdf:nodeID="A414"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A429">
    <rdf:rest rdf:nodeID="A185"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Task"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/HistoricalEvent">
    <skos:prefLabel>Historical Event</skos:prefLabel>
    <skos:definition>An event which occurred in time, with an actual end earlier than the present moment.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A431"/>
    <rdfs:subClassOf rdf:nodeID="A254"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Template">
    <skos:scopeNote>Use gist:isBasedOn to link the object made from the template back to the template.</skos:scopeNote>
    <skos:prefLabel>Template</skos:prefLabel>
    <skos:example>A die in manufacturing is used to make stamped parts; a form provides a structure and fields to be filled in; a cookie cutter is a template for cookies.</skos:example>
    <skos:definition>Something used to make objects in its own image.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A404">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isTriggeredBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A432">
    <rdf:rest rdf:nodeID="A237"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Content"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasAddend">
    <skos:scopeNote>Commonly used with financial metrics.</skos:scopeNote>
    <skos:prefLabel>has addend</skos:prefLabel>
    <skos:example>In the equation 'profit = revenue - expenses', revenue is an addend and expenses is a subtrahend.</skos:example>
    <skos:definition>Relates an aspect to another aspect that is an additive component of it.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A231">
    <rdf:rest rdf:nodeID="A370"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Agreement"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A433">
    <owl:hasValue rdf:resource="https://w3id.org/semanticarts/ns/data/gist/_Aspect_mass"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/symbol">
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <skos:prefLabel>symbol</skos:prefLabel>
    <skos:example>The ASCII symbol for square meter is m^2.</skos:example>
    <skos:definition>A symbol for something using only ASCII characters.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/offersToProvide">
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Offer"/>
    <skos:scopeNote>This will most often be a good or service, but could be an amount of money, e.g., for currency exchange.</skos:scopeNote>
    <skos:prefLabel>offers to provide</skos:prefLabel>
    <skos:example>An offer to provide a specific product in exchange for an amount of money or to pay a certain price for a home that is for sale.</skos:example>
    <skos:definition>Relates an offer to the thing being made available for exchange.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfMole">
    <skos:prefLabel>exponent of mole</skos:prefLabel>
    <skos:example>In the equation '1 katal = 1 x mole per second'&#xD;
&#xD;
		the conversion factor for katal is 1&#xD;
		the exponent of mole is 1&#xD;
		the exponent of second is -1&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing katal must be a multiple of mole per second.</skos:example>
    <skos:definition>The exponent of mole in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A297"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A266">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A179"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Medium">
    <skos:prefLabel>Medium</skos:prefLabel>
    <skos:example>Paper, clay, a computer monitor.</skos:example>
    <skos:definition>A physical material on which a work can be rendered, represented, or implemented.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/conformsTo">
    <gist:rangeIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
    <skos:prefLabel>conforms to</skos:prefLabel>
    <skos:example>Meet an obligation; adhere to a specification or standard; meet terms and conditions of an offer; comply with a regulation.</skos:example>
    <skos:definition>The subject is consistent with or satisfies the requirements, rules, or expectations established by the object.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
