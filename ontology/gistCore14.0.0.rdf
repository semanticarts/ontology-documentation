    <rdf:rest rdf:nodeID="A155"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedLong"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A156">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/CatalogItem"/>
    <owl:onProperty rdf:nodeID="A157"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A158">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A156"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Task">
    <skos:scopeNote>Use the property gist:isBasedOn to link a task back to the task template.</skos:scopeNote>
    <skos:scopeNote>This term is broader than the English word 'task,' which implies assignment, responsibility, or duty. In ordinary English going to a concert has a goal but is (generally) done for pleasure rather than out of obligation, and would not be considered a task, while according to the gist definition it is a task. The expansion of meaning is deliberate, so that anything that has a goal and can be specified by a task template is a task.</skos:scopeNote>
    <skos:scopeNote>Something that could potentially be executed, which is merely described but not proposed in any specific way, such as a business process for onboarding a new employee, or the steps in a recipe for making polyethylene from ethylene, is not a task but rather a task template.</skos:scopeNote>
    <skos:prefLabel>Task</skos:prefLabel>
    <skos:definition>An activity or piece of work that is either proposed, planned, scheduled, underway, or completed.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A20"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A129">
    <rdf:rest rdf:nodeID="A159"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A160">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/owns">
    <skos:scopeNote>There is a long list of potential range classes.</skos:scopeNote>
    <skos:scopeNote>The ultimate form of ownership is the right to destroy.</skos:scopeNote>
    <skos:prefLabel>owns</skos:prefLabel>
    <skos:definition>Relates a party to something that it possesses and controls.</skos:definition>
    <rdfs:domain rdf:nodeID="A161"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A36">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A162"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A17">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A163"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasNavigationalParent">
    <skos:prefLabel>has navigational parent</skos:prefLabel>
    <skos:example>Refrigerator handles are not refrigerators, but it may be useful to represent their relationship hierarchically for a faceted UI filter.</skos:example>
    <skos:definition>Relates a child category to a parent category in an informal (e.g., faceted) hierarchy.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A164">
    <owl:unionOf rdf:nodeID="A165"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A166">
    <rdf:rest rdf:nodeID="A167"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/EventSpecification">
    <skos:scopeNote>This concept is useful for risk assessment and insurance policies.</skos:scopeNote>
    <skos:prefLabel>Event Specification</skos:prefLabel>
    <skos:example>An insurance company defines the characteristics of a weather event that must be satisfied for it to qualify as a hail storm covered in its homeowner's policy; a bank defines the point at which a borrower defaults on a loan.</skos:example>
    <skos:definition>A characterization of an event that might happen.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Specification"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Contract">
    <skos:prefLabel>Contract</skos:prefLabel>
    <skos:definition>An agreement which can be enforced by law.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A168"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A169">
    <rdf:rest rdf:nodeID="A105"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Component"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A170">
    <owl:intersectionOf rdf:nodeID="A171"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A172">
    <rdf:rest rdf:nodeID="A173"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/ContentExpression"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A174">
    <owl:intersectionOf rdf:nodeID="A175"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A176">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isUnderJurisdictionOf">
    <skos:prefLabel>is under jurisdiction of</skos:prefLabel>
    <skos:definition>Relates a law, contract, etc., to the system of law or government which has the power, right, or authority to interpret and apply it.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/data/gist/_Aspect_volume">
    <skos:prefLabel>volume</skos:prefLabel>
    <skos:editorialNote>This instance has been duplicated from reference data so it can be used in property restrictions.</skos:editorialNote>
    <skos:definition>The aspect volume.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A177">
    <rdf:rest rdf:nodeID="A178"/>
    <rdf:first rdf:nodeID="A50"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A179">
    <owl:hasValue rdf:resource="https://w3id.org/semanticarts/ns/data/gist/_Aspect_area"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A180">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
    <owl:onProperty rdf:nodeID="A181"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Permission">
    <skos:prefLabel>Permission</skos:prefLabel>
    <skos:example>Permission could be broad, such as free speech, but more often is very specific, such as the right to enter a particular property.</skos:example>
    <skos:definition>A description of things one is permitted to do.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A182"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/BundledCatalogItem">
    <skos:prefLabel>Bundled Catalog Item</skos:prefLabel>
    <skos:example>A kit containing several parts offered together; a product plus a warranty.</skos:example>
    <skos:definition>Any combination of descriptions of things offered together.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A183"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasGoal">
    <skos:prefLabel>has goal</skos:prefLabel>
    <skos:example>The sales division of a company has the goal of acquiring new customers and contracts.</skos:example>
    <skos:definition>Relates something to the end towards which it directs effort.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/rangeIncludes">
    <skos:scopeNote>This property is used to guide the ontology user; like all annotation properties, it does not play a role in inference.</skos:scopeNote>
    <skos:scopeNote>There may be multiple rangeIncludes assertions on a single property.</skos:scopeNote>
    <skos:prefLabel>range includes</skos:prefLabel>
    <skos:example>The range of the property gist:isCategorizedBy includes gist:Category.</skos:example>
    <skos:definition>Relates a property to a class that is an expected type of its values.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A144">
    <owl:unionOf rdf:nodeID="A184"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A185">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A186"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A187">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A162">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isTriggeredBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A188">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:cardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/links"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A189">
    <owl:someValuesFrom rdf:nodeID="A190"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasPhysicalLocation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A191">
    <rdf:rest rdf:nodeID="A192"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A183">
    <owl:intersectionOf rdf:nodeID="A193"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasPhysicalLocation">
    <skos:scopeNote>This property does not distinguish between things whose locations are stable and those whose locations change over time; e.g., a fire hydrant vs. a car.</skos:scopeNote>
    <skos:prefLabel>has physical location</skos:prefLabel>
    <skos:definition>Relates something to its physical location.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfSecond">
    <skos:prefLabel>exponent of second</skos:prefLabel>
    <skos:example>In the equation '1 watt-hour = 3600 x kilogram meterSquared per secondSquared'&#xD;
&#xD;
		the conversion factor for watt-hour is 3600&#xD;
		the exponent of kilogram is 1&#xD;
		the exponent of meter is 2&#xD;
		the exponent of second is -2&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing watt-hour must be a multiple of kilogram meterSquared per secondSquared.</skos:example>
    <skos:definition>The exponent of second in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A194"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualStartYear">
    <skos:scopeNote>Used for things where the precision of a year is sufficient. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included.</skos:scopeNote>
    <skos:prefLabel>actual start year</skos:prefLabel>
    <skos:example>The tenure of the current chairman of the board began in 2021.</skos:example>
    <skos:example>'2021-01-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual date that something started, with precision of one year.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A195">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A196"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isAssignmentTo">
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Assignment"/>
    <skos:scopeNote>While typically this predicate will be used with gist:Assignment subjects, there may be other use cases, and therefore a domain is not specified.</skos:scopeNote>
    <skos:prefLabel>is assignment to</skos:prefLabel>
    <skos:definition>Relates something (typically an assignment) to the thing the resource is assigned to, such as a project, position, organization, pay rate, or billing rate.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Text">
    <skos:prefLabel>Text</skos:prefLabel>
    <skos:example>Negative example: graphical content.</skos:example>
    <skos:definition>Content expressed as words and numbers.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A116"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A197">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A198"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A199">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/MediaType"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isExpressedIn"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A200">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A201"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Equipment">
    <skos:prefLabel>Equipment</skos:prefLabel>
    <skos:example>A machine, a router, a car, a baseball bat.</skos:example>
    <skos:definition>Human-made, tangible property other than land or buildings used to perform a task or activity.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A202"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A203">
    <rdf:rest rdf:nodeID="A204"/>
    <rdf:first rdf:nodeID="A205"/>
  </rdf:Description>
