  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/GeoVolume">
    <skos:prefLabel>Geographic Volume</skos:prefLabel>
    <skos:definition>A three-dimensional space on or near the surface of the Earth, such as an oil reservoir, the body of a lake, or an airspace.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A272"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
