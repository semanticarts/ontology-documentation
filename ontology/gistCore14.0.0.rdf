  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/data/gist/_Aspect_probability">
    <skos:prefLabel>probability</skos:prefLabel>
    <skos:editorialNote>This instance has been duplicated from reference data so it can be used in property restrictions.</skos:editorialNote>
    <skos:definition>The aspect probability.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A93">
    <rdf:rest rdf:nodeID="A209"/>
    <rdf:first rdf:nodeID="A210"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfMeter">
    <skos:prefLabel>exponent of meter</skos:prefLabel>
    <skos:example>In the equation '1 microgram per milliliter = 0.001 x kilogram per meterCubed'&#xD;
&#xD;
		the conversion factor for microgram per milliliter is 0.001&#xD;
		the exponent of kilogram is 1&#xD;
		the exponent of meter is -3&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing microgram per milliliter must be a multiple of kilogram per meterCubed.</skos:example>
    <skos:definition>The exponent of meter in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A211"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A212">
    <owl:unionOf rdf:nodeID="A213"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/license">
    <skos:scopeNote>Could refer to a license object by URI or name or could consist of the license text itself.</skos:scopeNote>
    <skos:prefLabel>license</skos:prefLabel>
    <skos:example>The gist ontology is licensed under the CC By 4.0 license.</skos:example>
    <skos:definition>Relates something to its conditions of use.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
