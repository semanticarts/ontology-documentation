  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isMadeUpOf">
    <skos:prefLabel>is made up of</skos:prefLabel>
    <skos:example>A vase is made of clay; water is made up of hydrogen and oxygen.</skos:example>
    <skos:definition>Relates something to a substance that it is made up of.</skos:definition>
