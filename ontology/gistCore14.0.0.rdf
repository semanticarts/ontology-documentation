  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfBit">
    <skos:prefLabel>exponent of bit</skos:prefLabel>
    <skos:example>In the equation '1 megabit per second = 1000000 x bit per second'&#xD;
&#xD;
		the conversion factor for megabit per second is 1000000&#xD;
		the exponent of bit is 1&#xD;
		the exponent of second is -1&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing megabit per second must be a multiple of bit per second.</skos:example>
    <skos:definition>The exponent of bit in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A100"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
