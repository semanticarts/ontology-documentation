  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/plannedEndMinute">
    <skos:scopeNote>Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual.</skos:scopeNote>
    <skos:prefLabel>planned end minute</skos:prefLabel>
    <skos:example>'2021-06-01T08:32:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The date and time that something is or was planned to end, with precision of one minute.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/plannedEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime">
    <skos:scopeNote>This is an abstraction over the various precisions of actual end time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.</skos:scopeNote>
    <skos:prefLabel>actual end date time</skos:prefLabel>
    <skos:definition>The actual date and time that something ended, with no implied precision.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/endDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/links">
    <gist:rangeIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/NetworkNode"/>
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/NetworkLink"/>
    <skos:prefLabel>links</skos:prefLabel>
    <skos:definition>Relates a network link to a network node that it connects to another node. Used when the connection is undirected or the direction is not known.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
