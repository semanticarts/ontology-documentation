<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns="https://w3id.org/semanticarts/ontology/gistCore#"
    xmlns:gist="https://w3id.org/semanticarts/ns/ontology/gist/"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:gistd="https://w3id.org/semanticarts/ns/data/gist/"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#" > 
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isBasedOn">
    <skos:prefLabel>is based on</skos:prefLabel>
    <skos:example>A document is based on a document template; a metric computing the average income of a population is based on the metric for individual income.</skos:example>
    <skos:definition>The object is a foundation for, a starting point for, gave rise to, or justifies the subject.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A0">
    <rdf:rest rdf:nodeID="A1"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#negativeInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasMultiplier">
    <skos:scopeNote>Provides a supplemental method of decomposing a unit of measure or aspect into component factors. Enables dimensional analysis such as miles per hour x hours = miles.</skos:scopeNote>
    <skos:prefLabel>has multiplier</skos:prefLabel>
    <skos:example>Miles per hour has miles as a multiplier and hours as a divisor; speed has distance as a multiplier and duration as a divisor.</skos:example>
    <skos:definition>Relates a unit of measure to another unit of measure that is a factor, or relates an aspect to another aspect that is a factor.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A2">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/CountryGovernment">
    <skos:scopeNote>While a country government may enter into treaties with other country governments, there are no governing relationships among the treaty members.</skos:scopeNote>
    <skos:prefLabel>Country Government</skos:prefLabel>
    <skos:definition>A government organization which asserts both sovereignty (i.e., it is not governed by some other government organization) and governance over an entity generally recognized as a country.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A3"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/SubCountryGovernment"/>
    <rdfs:subClassOf rdf:nodeID="A4"/>
    <rdfs:subClassOf rdf:nodeID="A5"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A6">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isGovernedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ReferenceValue">
    <skos:prefLabel>Reference Value</skos:prefLabel>
    <skos:example>The sales goal for a company.</skos:example>
    <skos:definition>A magnitude that was neither measured nor estimated but set by fiat.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#example">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A1">
    <rdf:rest rdf:nodeID="A7"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A8">
    <rdf:rest rdf:nodeID="A9"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Address"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/linksFrom">
    <gist:rangeIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/NetworkNode"/>
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/NetworkLink"/>
    <skos:prefLabel>links from</skos:prefLabel>
    <skos:definition>Relates a network link to its origin network node. Unlike the superproperty, this represents a directed connection.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/links"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A10">
    <owl:intersectionOf rdf:nodeID="A11"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A12">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A13"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ContentExpression">
    <skos:prefLabel>Content Expression</skos:prefLabel>
    <skos:definition>Intellectual property reduced to text, audio, etc.  If it contains text (written or spoken), it will be expressed in a language.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="A14"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Content"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A15">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/containedText"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A16">
    <rdf:rest rdf:nodeID="A17"/>
    <rdf:first rdf:nodeID="A18"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/conversionOffset">
    <skos:prefLabel>conversion offset</skos:prefLabel>
    <skos:definition>&#xD;
		A value used along with a conversion factor to relate a unit to its corresponding unit in the International System of Units. In the equation below, the conversion offset is 459.669607 and the conversion factor is 5/9.&#xD;
&#xD;
		y degrees Fahrenheit = (y + 459.669607) x 5/9 degrees Kelvin&#xD;
&#xD;
		To convert from Fahrenheit to Kelvin, first add the offset and then multiply by the conversion factor.&#xD;
&#xD;
		To convert from Kelvin to Fahrenheit, reverse the steps: first divide by the conversion factor and then subtract the offset.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude">
    <skos:scopeNote>An accuracy can be assigned to a magnitude using the property has accuracy.</skos:scopeNote>
    <skos:prefLabel>Magnitude</skos:prefLabel>
    <skos:example>A model of car could have a wheelbase of 113.2 inches. In this example, the aspect is wheelbase, the unit of measure is inch, and the numeric value is 113.2.</skos:example>
    <skos:definition>The amount of a measurable characteristic (aspect).</skos:definition>
    <owl:equivalentClass rdf:nodeID="A19"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <rdfs:seeAlso rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAccuracy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isCategorizedBy">
    <gist:rangeIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <skos:prefLabel>is categorized by</skos:prefLabel>
    <skos:definition>Relates something to a taxonomy term or other less formally defined classification.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A20">
    <owl:intersectionOf rdf:nodeID="A21"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/AddressUsageType">
    <skos:scopeNote>If you are using temporal relations involving addresses, this category should be used to qualify the temporal relation rather than the address itself, since the same address may have different uses in different contexts, by different people and organizations, or at different times.</skos:scopeNote>
    <skos:prefLabel>Address Usage Type</skos:prefLabel>
    <skos:example>Billing, business, personal, postal, residence.</skos:example>
    <skos:definition>A category indicating the context or manner in which an address may be used.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A22">
    <rdf:rest rdf:nodeID="A23"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A24">
    <owl:hasValue rdf:resource="https://w3id.org/semanticarts/ns/data/gist/_Aspect_probability"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A25">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A26">
    <rdf:rest rdf:nodeID="A27"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedInt"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A28">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A29">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Task"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A30">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A24"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A31">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A32"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isExpressedIn">
    <gist:rangeIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Language"/>
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Text"/>
    <skos:prefLabel>is expressed in</skos:prefLabel>
    <skos:definition>Relates something to the language it is expressed in.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect">
    <skos:prefLabel>has aspect</skos:prefLabel>
    <skos:definition>Relates a magnitude to its aspect (measurable characteristic).</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalAddressType">
    <skos:prefLabel>Physical Address Type</skos:prefLabel>
    <skos:example>Street address, PO box, FPO code.</skos:example>
    <skos:definition>A category indicating local customary characterizations of physical addresses.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A33">
    <rdf:rest rdf:nodeID="A34"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GovernmentOrganization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A35">
    <rdf:rest rdf:nodeID="A36"/>
    <rdf:first rdf:nodeID="A37"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A38">
    <rdf:rest rdf:nodeID="A39"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Requirement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ProductSpecification">
    <skos:prefLabel>Product Specification</skos:prefLabel>
    <skos:definition>Offering something which could be physically warehoused or digitally stored.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A40"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Specification">
    <skos:scopeNote>Although a characterization of how to do something is often called a specification, the intended meaning here is limited to specifying what something is. The focus is on the what, not the how. Use gist:TaskTemplate for specifying the how, such as a plan or process specification.</skos:scopeNote>
    <skos:prefLabel>Specification</skos:prefLabel>
    <skos:example>The specification of the iPhone 14; hypothetical events covered by a homeowner's insurance policy.</skos:example>
    <skos:definition>One or more characteristics that specify what it means to be a particular type of thing, such as a material, product, service or event. A specification is sufficiently precise to allow evaluating conformance to the specification.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A41">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isDirectPartOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A42">
    <owl:intersectionOf rdf:nodeID="A43"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/plannedEndYear">
    <skos:scopeNote>Used for anything with a planned end date where precision of one year is sufficient. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included.</skos:scopeNote>
    <skos:prefLabel>planned end year</skos:prefLabel>
    <skos:example>The automobile manufacturer announced that it will stop producing gas-powered vehicles in 2035.</skos:example>
    <skos:example>'2021-01-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The date that something is or was planned to end, with precision of one year.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/plannedEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A44">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/IntellectualProperty">
    <skos:scopeNote>This concept includes works that are out of copyright or were never formally registered; the defining feature is not that it is legally protected but that it is an intangible creation of the human mind.</skos:scopeNote>
    <skos:scopeNote>For literature this could be called the 'Work', except that 'work' is a highly overloaded term (expenditure of energy, resource consumption, art).  Often the first expression precedes our recognition of the IP, but subsequent expressions are known to be derivatives of the IP, even if they are expression-to-expression translations (or copies).</skos:scopeNote>
    <skos:prefLabel>Intellectual Property</skos:prefLabel>
    <skos:example>The Old Man and The Sea; the Page Rank algorithm; the brand Coca Cola.</skos:example>
    <skos:definition>An intangible work, invention, or concept, independent of its being expressed in text, audio, video, image, or live performance. IP can also be tacit knowledge, know-how, or skill.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A45">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoVolume"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A46">
    <owl:intersectionOf rdf:nodeID="A47"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A48">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/CountryGeoRegion"/>
    <owl:onProperty rdf:nodeID="A49"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/occursIn">
    <skos:prefLabel>occurs in</skos:prefLabel>
    <skos:definition>Relates something, such as an event, to the geographic location where it did, does, or will happen.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A50">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/OrderedMember"/>
    <owl:onProperty rdf:nodeID="A51"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A52">
    <rdf:rest rdf:nodeID="A53"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfUSDollar">
    <skos:scopeNote>The factors for converting from one currency to another change constantly.</skos:scopeNote>
    <skos:prefLabel>exponent of US dollar</skos:prefLabel>
    <skos:example>In the equation '1 million dollars per week = 1.65344 x dollar per second'&#xD;
&#xD;
		the conversion factor for million dollars per week is 1.65344&#xD;
		the exponent of US Dollar is 1&#xD;
		the exponent of second is -1&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing million dollars per week must be a multiple of dollar per second.</skos:example>
    <skos:definition>The exponent of US Dollar in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A54"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A55">
    <rdf:rest rdf:nodeID="A56"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/ContentExpression"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A57">
    <owl:someValuesFrom rdf:nodeID="A58"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A49">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isGovernedBy"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A59">
    <owl:unionOf rdf:nodeID="A60"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A61">
    <rdf:rest rdf:nodeID="A62"/>
    <rdf:first rdf:nodeID="A63"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A64">
    <rdf:rest rdf:nodeID="A65"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A66">
    <rdf:rest rdf:nodeID="A67"/>
    <rdf:first rdf:nodeID="A68"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A69">
    <owl:someValuesFrom rdf:nodeID="A70"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A71">
    <owl:intersectionOf rdf:nodeID="A72"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Category">
    <skos:scopeNote>Often a type can be modeled either as an owl:Class or as a gist:Category. Use the latter if you don't care much about the formal structure of the different types, or if there is a whole hierarchy of types that are going to be managed by a group separate from the ontology developers. The formal structure may be defined elsewhere and linked to, if necessary.</skos:scopeNote>
    <skos:prefLabel>Category</skos:prefLabel>
    <skos:example>Tags used in folksonomies; formal definitions from other systems.</skos:example>
    <skos:definition>A concept or label used to categorize other instances without specifying any formal semantics.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="A73"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasUniqueNavigationalParent">
    <skos:prefLabel>has unique navigational parent</skos:prefLabel>
    <skos:definition>Relates a subject category to a unique parent category in an informal (e.g., faceted) hierarchy.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasNavigationalParent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A74">
    <rdf:rest rdf:nodeID="A75"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasUnitGroup">
    <skos:prefLabel>has unit group</skos:prefLabel>
    <skos:example>The aspect distance can have a unit group that includes the units meter, inch, foot, etc.</skos:example>
    <skos:definition>Relates an aspect to a unit group. The aspect can be measured using any of the members of the unit group.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/startDateTime">
    <skos:scopeNote>Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.</skos:scopeNote>
    <skos:scopeNote>This property is neutral along two dimensions: precision (e.g., day, second, millisecond) and actual vs. planned. As such, it will generally not be asserted directly except in special cases (e.g., for time intervals).</skos:scopeNote>
    <skos:prefLabel>start date time</skos:prefLabel>
    <skos:definition>The date and time that something starts.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/atDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A76">
    <rdf:rest rdf:nodeID="A77"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Aspect">
    <skos:scopeNote>Depending on implementation, every aspect should be related to a unit group either directly or through a broader aspect. For example, angle of incidence could be related to the broader concept of angle, which in turn is related to a unit group, or it could be related directly to the unit group without the hierarchical relationship.</skos:scopeNote>
    <skos:prefLabel>Aspect</skos:prefLabel>
    <skos:example>Length, weight, cost, cycle time, defect rate.</skos:example>
    <skos:definition>A measurable characteristic.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A78">
    <rdf:rest rdf:nodeID="A79"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/plannedStartMinute">
    <skos:scopeNote>Used for things like meetings and time card entries, where the hour and minute are important. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.</skos:scopeNote>
    <skos:prefLabel>planned start minute</skos:prefLabel>
    <skos:example>'2021-06-01T08:32:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The date and time that something is or was planned to start, with precision of one minute.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A80">
    <rdf:rest rdf:nodeID="A81"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A82">
    <rdf:rest rdf:nodeID="A83"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A84">
    <owl:unionOf rdf:nodeID="A85"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ElectronicAddressType">
    <skos:prefLabel>Electronic Address Type</skos:prefLabel>
    <skos:example>A URL, file system path, email address, mobile telephone number.</skos:example>
    <skos:definition>A category indicating a kind of electronic address. Such a category is usually based on the technology that enables routing to the address referent.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A86">
    <rdf:rest rdf:nodeID="A25"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A87">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoPoint"/>
    <owl:onProperty rdf:nodeID="A88"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Composite">
    <skos:scopeNote>This is an abstract class that will not be directly instantiated.</skos:scopeNote>
    <skos:scopeNote>This class is not disjoint with gist:Component, because a composite can itself be a component of a larger composite.</skos:scopeNote>
    <skos:scopeNote>Some composites, like systems, networks, and ordered collections, have internal organization, while others, such as unordered collections, typically do not.</skos:scopeNote>
    <skos:prefLabel>Composite</skos:prefLabel>
    <skos:example>A library (collection of books); a network of pipes and valves; a computer network of routers and computers.</skos:example>
    <skos:definition>Something which is made up of various parts or elements that are independently identifiable.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A89">
    <rdf:rest rdf:nodeID="A90"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A91">
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxCardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A92">
    <rdf:rest rdf:nodeID="A93"/>
    <rdf:first rdf:nodeID="A94"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A95">
    <owl:intersectionOf rdf:nodeID="A96"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isPartOf">
    <skos:scopeNote>The transitive version of gist:isDirectPartOf.</skos:scopeNote>
    <skos:scopeNote>Because the part has independent existence, there is no cascading delete.</skos:scopeNote>
    <skos:prefLabel>is part of</skos:prefLabel>
    <skos:definition>The relationship between a part and a whole where the part has independent existence.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/containedText">
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Text"/>
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Tag"/>
    <skos:prefLabel>contained text</skos:prefLabel>
    <skos:example>The string associated with a tag or with text content.</skos:example>
    <skos:definition>A string that is closely associated with an individual.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A97">
    <owl:intersectionOf rdf:nodeID="A98"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A99">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/plannedEndDate">
    <skos:scopeNote>Used for anything with a planned end date, such as when a lease will expire, when an offer is no longer available, etc. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision.</skos:scopeNote>
    <skos:prefLabel>planned end date</skos:prefLabel>
    <skos:example>'2021-06-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The date that something is or was planned to end, with precision of one day.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/plannedEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A100">
    <owl:unionOf rdf:nodeID="A101"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ID">
    <skos:scopeNote>Used in conjunction with gist:isIdentifiedBy.</skos:scopeNote>
    <skos:prefLabel>ID</skos:prefLabel>
    <skos:example>SSN for a person; serial number for a product; employee ID for a person.</skos:example>
    <skos:definition>Content that is used to uniquely identify something or someone.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A102"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/data/gist/_Aspect_monetary_value">
    <skos:prefLabel>monetary value</skos:prefLabel>
    <skos:editorialNote>This instance has been duplicated from reference data so it can be used in property restrictions.</skos:editorialNote>
    <skos:definition>The aspect monetary value.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A103">
    <owl:unionOf rdf:nodeID="A38"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/NetworkNode">
    <skos:prefLabel>Network Node</skos:prefLabel>
    <skos:example>A person's account is a node in a social network; a valve is a node in a network of pipes.</skos:example>
    <skos:definition>A node in a network.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="A104"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Component"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A105">
    <rdf:rest rdf:nodeID="A106"/>
    <rdf:first rdf:nodeID="A107"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A108">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A109"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A54">
    <owl:unionOf rdf:nodeID="A86"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A110">
    <owl:unionOf rdf:nodeID="A64"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A111">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A87"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A112">
    <rdf:rest rdf:nodeID="A113"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/ContingentObligation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDate">
    <skos:scopeNote>Used for things where the precision of a date is sufficient, such as most projects, tasks, and the like. Recommended usage is to zero out the hours through microseconds to avoid spurious precision.</skos:scopeNote>
    <skos:prefLabel>actual end date</skos:prefLabel>
    <skos:example>'2021-06-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual date that something ended, with precision of one day.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A114">
    <owl:intersectionOf rdf:nodeID="A115"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isIdentifiedBy">
    <skos:scopeNote>This is like a URI: a thing can have more than one ID, but each ID can refer to only one thing. Note that it is possible to have two IDs with the same text that refer to different things.</skos:scopeNote>
    <skos:prefLabel>is identified by</skos:prefLabel>
    <skos:definition>Relates something to a content object that uniquely identifies it.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/ID"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A116">
    <owl:intersectionOf rdf:nodeID="A55"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A117">
    <rdf:rest rdf:nodeID="A118"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A119">
    <owl:unionOf rdf:nodeID="A120"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A121">
    <owl:intersectionOf rdf:nodeID="A122"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A123">
    <owl:intersectionOf rdf:nodeID="A78"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A81">
    <rdf:rest rdf:nodeID="A26"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A124">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A125">
    <owl:someValuesFrom rdf:nodeID="A126"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isAllocatedBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A109">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/CountryGeoRegion">
    <skos:prefLabel>Country Geographic Region</skos:prefLabel>
    <skos:definition>A geographic region governed by exactly one country government.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A127"/>
    <rdfs:subClassOf rdf:nodeID="A128"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A58">
    <owl:intersectionOf rdf:nodeID="A129"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Message">
    <skos:prefLabel>Message</skos:prefLabel>
    <skos:example>An email, voice, or web service message; a phone call.</skos:example>
    <skos:definition>A specific instance of content sent from a sender to at least one other recipient.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A114"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A130">
    <owl:unionOf rdf:nodeID="A131"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A51">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isFirstMemberOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A56">
    <rdf:rest rdf:nodeID="A132"/>
    <rdf:first rdf:nodeID="A133"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A134">
    <rdf:rest rdf:nodeID="A135"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/domainIncludes">
    <skos:scopeNote>This property is used to guide the ontology user; like all annotation properties, it does not play a role in inference.</skos:scopeNote>
    <skos:scopeNote>There may be multiple domainIncludes assertions on a single property.</skos:scopeNote>
    <skos:prefLabel>domain includes</skos:prefLabel>
    <skos:example>The domain of the property gist:containedText includes gist:Tag and gist:Text.</skos:example>
    <skos:definition>Relates a property to a class that the property is expected to be used on.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A47">
    <rdf:rest rdf:nodeID="A136"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A137">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A138"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A139">
    <owl:intersectionOf rdf:nodeID="A140"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A141">
    <owl:hasValue rdf:resource="https://w3id.org/semanticarts/ns/data/gist/_Aspect_volume"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A65">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A142">
    <owl:intersectionOf rdf:nodeID="A143"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/conversionFactor">
    <skos:scopeNote>To convert a numeric value from one unit of measure to another, multiply by the conversion factor of the first unit and then divide by the conversion factor of the second unit.&#xD;
&#xD;
	For example, to convert 27 feet to yards:&#xD;
&#xD;
		the conversion factor of foot is 0.3048&#xD;
		the conversion factor of yard is 0.9144&#xD;
&#xD;
		so&#xD;
&#xD;
		27 feet = (27 x 0.3048) / 0.9144 = 9 yards</skos:scopeNote>
    <skos:prefLabel>conversion factor</skos:prefLabel>
    <skos:example>In the equation 1 inch = 0.0254 meters, the value 0.0254 is the conversion factor of inch.</skos:example>
    <skos:definition>A value that relates a unit of measure to units of the International System of Units.</skos:definition>
    <rdfs:seeAlso rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/conversionOffset"/>
    <rdfs:range rdf:nodeID="A144"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A145">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoPoint"/>
    <owl:onProperty rdf:nodeID="A146"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/data/gist/_Aspect_mass">
    <skos:prefLabel>mass</skos:prefLabel>
    <skos:editorialNote>This instance has been duplicated from reference data so it can be used in property restrictions.</skos:editorialNote>
    <skos:definition>The aspect mass.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A147">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <owl:onProperty rdf:nodeID="A148"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isRecognizedBy">
    <skos:prefLabel>is recognized by</skos:prefLabel>
    <skos:example>The existence of a particular company is recognized by the state.</skos:example>
    <skos:definition>Relates something to a party that formally acknowledges its existence, validity, or legality.</skos:definition>
    <rdfs:range rdf:nodeID="A149"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A150">
    <rdf:rest rdf:nodeID="A151"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/data/gist/_Aspect_altitude">
    <skos:prefLabel>altitude</skos:prefLabel>
    <skos:editorialNote>This instance has been duplicated from reference data so it can be used in property restrictions.</skos:editorialNote>
    <skos:definition>The aspect altitude.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Intention">
    <skos:scopeNote>The 'teleological' aspect of a system that indicates things are done with a purpose.</skos:scopeNote>
    <skos:prefLabel>Intention</skos:prefLabel>
    <skos:definition>A goal, desire, or aspiration.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A152">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A153">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A154"/>
  </rdf:Description>
