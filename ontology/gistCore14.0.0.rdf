    <rdf:first rdf:nodeID="A368"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A373">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf"/>
  </rdf:Description>
