  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfNumber">
    <skos:scopeNote>Use when the unit of measure involves a count or other number.</skos:scopeNote>
    <skos:prefLabel>exponent of number</skos:prefLabel>
    <skos:example>In the equation '1 beat per minute = 0.016667 x number per second'&#xD;
&#xD;
		the conversion factor for beat per minute is 0.016667&#xD;
		the exponent of number is 1&#xD;
		the exponent of second is -1&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing beat per minute must be a multiple of number per second.</skos:example>
    <skos:definition>The exponent of number in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A468"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A310">
    <owl:intersectionOf rdf:nodeID="A227"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A445">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Place"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/occursIn"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A469">
    <owl:intersectionOf rdf:nodeID="A385"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A337">
    <rdf:rest rdf:nodeID="A352"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/GeneralMediaType">
    <skos:prefLabel>General Media Type</skos:prefLabel>
    <skos:example>Audio, still image, video, textual, physical (e.g., a statue), or performance (i.e. a play).  Or it could be oil or pastel for a painting.</skos:example>
    <skos:definition>The real-world media type for content.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/encryptedText">
    <skos:prefLabel>encrypted text</skos:prefLabel>
    <skos:definition>Links to the string corresponding to EncryptedText</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/containedText"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A451">
    <rdf:rest rdf:nodeID="A443"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A421">
    <owl:unionOf rdf:nodeID="A249"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A31">
    <rdf:rest rdf:nodeID="A403"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A470">
    <owl:someValuesFrom rdf:nodeID="A462"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasGiver"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A440">
    <rdf:rest rdf:nodeID="A471"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/conversionFactor">
    <skos:scopeNote>To convert a numeric value from one unit of measure to another, multiply by the conversion factor of the first unit and then divide by the conversion factor of the second unit.&#xD;
&#xD;
	For example, to convert 27 feet to yards:&#xD;
&#xD;
		the conversion factor of foot is 0.3048&#xD;
		the conversion factor of yard is 0.9144&#xD;
&#xD;
		so&#xD;
&#xD;
		27 feet = (27 x 0.3048) / 0.9144 = 9 yards</skos:scopeNote>
    <skos:prefLabel>conversion factor</skos:prefLabel>
    <skos:definition>A value that relates a unit of measure to units of the International System of Units. For example, in the equation 1 inch = 0.0254 meters, the value 0.0254 is the conversion factor of inch.</skos:definition>
    <rdfs:seeAlso rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/conversionOffset"/>
    <rdfs:range rdf:nodeID="A454"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasDirectBroader">
    <skos:scopeNote>Unlike gist:hasBroader, this property is not transitive. It is safest to use this property when semantic directness is inherent in the relationship. Otherwise, there is a risk of making a hasDirectBroader assertion and then later inserting an intermediate part; this will result in making an asserted triple false even though there was no change in the world. When in doubt, use the transitive version gist:hasBroader.</skos:scopeNote>
    <skos:prefLabel>has direct broader</skos:prefLabel>
    <skos:definition>Relates a thing to another thing with a broader meaning, when there is no intermediate between them.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasBroader"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isTriggeredBy">
    <skos:scopeNote>For obligations, this property describes what must happen to trigger the contingent obligation. Other uses include controls, processes, etc.</skos:scopeNote>
    <skos:prefLabel>is triggered by</skos:prefLabel>
    <skos:example>The death benefit payout on a life insurance policy following the death of a specific person.</skos:example>
    <skos:example>Fire insurance is contingent on a particular building burning down</skos:example>
    <skos:definition>Relates a contingency, such as an event or obligation, to the event that gives rise to it.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Offer">
    <skos:prefLabel>Offer</skos:prefLabel>
    <skos:definition>A commitment to buy or sell a described or identified part or service.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A472"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/IntergovernmentalOrganization">
    <skos:prefLabel>Intergovernmental Organization</skos:prefLabel>
    <skos:example>The United Nations, the European Union, the MTA (Metropolitan Transit Authority)</skos:example>
    <skos:definition>An organization whose members are government organizations. This can comprise regional, municipal, state/province, or national level entities.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A469"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A407">
    <owl:intersectionOf rdf:nodeID="A423"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A40">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A410">
    <rdf:rest rdf:nodeID="A473"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/owns">
    <skos:prefLabel>owns</skos:prefLabel>
    <skos:definition>Possessing and controlling.  Ultimate form of ownership is the right to destroy.  Long list of potential Range classes</skos:definition>
    <rdfs:domain rdf:nodeID="A247"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A474">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isGeoContainedIn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Specification">
    <skos:scopeNote>Although a characterization of how to do something is often called a specification, the intended meaning here is limited to specifying what something is. The focus is on the what, not the how. Use the TaskTemplate class for specifying the how, such as a plan or process specification.</skos:scopeNote>
    <skos:prefLabel>Specification</skos:prefLabel>
    <skos:example>The specification of the iPhone 14; hypothetical events covered by a homeowner's insurance policy.</skos:example>
    <skos:definition>One or more characteristics that specify what it means to be a particular type of thing, such as a material, product, service or event. A specification is sufficiently precise to allow evaluating conformance to the specification.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A372">
    <owl:unionOf rdf:nodeID="A264"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A475">
    <rdf:rest rdf:nodeID="A348"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Place"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/TemporalRelation">
    <skos:scopeNote>Note that 'participant' does not imply agency; a non-sentient being can be participate in a temporal relation. For example, both a person and a house could be participants in a hypothetical relation 'lives at.'</skos:scopeNote>
    <skos:scopeNote>A temporal relation must have a minimum of two participants. For example, both the employer and the employee are participants in a temporal relation representing a period of employment.</skos:scopeNote>
    <skos:prefLabel>Temporal Relation</skos:prefLabel>
    <skos:example>employs-Employment, hasAddress-EstablishedLocation. One important context for reifying a property.</skos:example>
    <skos:definition>A relationship existing for a period of time.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="A186"/>
    <rdfs:subClassOf rdf:nodeID="A476"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A286">
    <rdf:rest rdf:nodeID="A433"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Task"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A362">
    <rdf:rest rdf:nodeID="A449"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/comesFromPlace">
    <skos:prefLabel>comes from place</skos:prefLabel>
    <skos:definition>Origin</skos:definition>
    <rdfs:range rdf:nodeID="A391"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Address">
    <skos:prefLabel>Address</skos:prefLabel>
    <skos:example>A PO Box, a URL to a PDF file.</skos:example>
    <skos:definition>A reference to a place (real or virtual) that can be located by some routing algorithm and where messages or things can be sent to or received from.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Content"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Building">
    <skos:scopeNote>User discretion can be applied to edge cases: e.g., is a traditional yurt 'relatively permanently situated' although it is portable and has a tent-like construction?</skos:scopeNote>
    <skos:prefLabel>Building</skos:prefLabel>
    <skos:example>Negative examples: houseboats (not built on land), caves (not man-made), food trucks and RVs (not permanently situated).</skos:example>
    <skos:example>A house, school, store, factory, chicken coop.</skos:example>
    <skos:definition>A relatively permanent man-made structure situated on a plot of land, having a roof and walls, commonly used for dwelling, entertaining, or working.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Landmark"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Artifact"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasMultiplier">
    <skos:scopeNote>Provides a supplemental method of decomposing a unit of measure or aspect into component factors. Enables dimensional analysis such as miles per hour x hours = miles.</skos:scopeNote>
    <skos:prefLabel>has multiplier</skos:prefLabel>
    <skos:example>Speed has distance as a multiplier and duration as a divisor.</skos:example>
    <skos:example>Miles per hour has miles as a multiplier and hour as a divisor.</skos:example>
    <skos:definition>Relates a unit of measure to another unit of measure that is a factor, or relates an aspect to another aspect that is a factor.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A71">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A20"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A358">
    <owl:intersectionOf rdf:nodeID="A475"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/GeoVolume">
    <skos:prefLabel>Geo Volume</skos:prefLabel>
    <skos:definition>A three-dimensional space on or near the surface of the Earth, such as an oil reservoir, the body of a lake, or an airspace.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A344"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Place"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A477">
    <owl:intersectionOf rdf:nodeID="A178"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasRecipient">
    <skos:prefLabel>has recipient</skos:prefLabel>
    <skos:definition>The recipient</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalEvent">
    <skos:prefLabel>Physical Event</skos:prefLabel>
    <skos:example>Negative examples: Excludes events that have no meaningful location, such as financial events or project milestones.</skos:example>
    <skos:example>A meeting, a car accident.</skos:example>
    <skos:definition>An event that can be said to have occurred at some place in space.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A478"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/data/gist/_Aspect_altitude">
    <skos:prefLabel>area</skos:prefLabel>
    <skos:editorialNote>This instance has been duplicated from reference data so it can be used in property restrictions.</skos:editorialNote>
    <skos:definition>The aspect altitude.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A472">
    <owl:intersectionOf rdf:nodeID="A188"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A244">
    <owl:unionOf rdf:nodeID="A261"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A141">
    <rdf:rest rdf:nodeID="A297"/>
    <rdf:first rdf:nodeID="A479"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/NetworkNode">
    <skos:prefLabel>Network Node</skos:prefLabel>
    <skos:example>A person is a node in a social network; a valve is a node in a network of pipes.</skos:example>
    <skos:definition>A node in a network.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="A480"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/OrderedCollection">
    <skos:scopeNote>Includes collections in which members occupy the same position in a 'tie.'</skos:scopeNote>
    <skos:prefLabel>Ordered Collection</skos:prefLabel>
    <skos:definition>A collection in which the members are sequentially ordered. All members of an OrderedCollection are OrderedMembers.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A255"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A187">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Medium"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isRenderedOn"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A481">
    <rdf:rest rdf:nodeID="A482"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A424">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/TaskTemplate">
    <skos:scopeNote>Use the property isBasedOn to link the Task back to the TaskTemplate.</skos:scopeNote>
    <skos:scopeNote>A task template may define a single activity or a series of activities; the level of granularity can be varied according to use case. For example, in a new employee onboarding process, signing up for benefits might be one activity, or it might be broken down into signing up for health insurance, signing up for dental insurance, etc.</skos:scopeNote>
    <skos:prefLabel>Task Template</skos:prefLabel>
    <skos:example>A business process for onboarding new employees.</skos:example>
    <skos:definition>An outline of a task of a particular type, which is the basis for executing such tasks.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A369"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Event">
    <skos:scopeNote>An event occurs during a time interval, which is distinct from the event.</skos:scopeNote>
    <skos:scopeNote>An event does not necessarily have either planned or actual start or end datetimes. For example, a conference can be in the planning phase without any dates selected, but is nevertheless an (unscheduled) event. The subclasses of Event state particular restrictions on planned and actual start and end dates.</skos:scopeNote>
    <skos:prefLabel>Event</skos:prefLabel>
    <skos:example>A transaction, conference, baseball game, earthquake.</skos:example>
    <skos:editorialNote>See guidance on removing the term in the next major release at https://github.com/semanticarts/gist/issues/947#issuecomment-1679565100.</skos:editorialNote>
    <skos:definition>Something that occurs over a period of time, often characterized as an activity being carried out by some person, organization, or software application or brought about by natural forces.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Network">
    <skos:prefLabel>Network</skos:prefLabel>
    <skos:example>A physical network could include connected computers or routers, whereas a social network would consist of related Person or Organization instances.</skos:example>
    <skos:definition>A network is a set of nodes connected by links.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A353"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A458">
    <owl:intersectionOf rdf:nodeID="A64"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A384">
    <owl:someValuesFrom rdf:nodeID="A128"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasParty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A328">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/latitude">
    <skos:prefLabel>latitude</skos:prefLabel>
    <skos:definition>Degrees above or below equator</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoPoint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A444">
    <owl:someValuesFrom rdf:nodeID="A422"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isAllocatedBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasBiologicalParent">
    <skos:prefLabel>has biological parent</skos:prefLabel>
    <skos:definition>Relates a living thing to its biological parent.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/LivingThing"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/LivingThing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A276">
    <owl:intersectionOf rdf:nodeID="A26"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A483">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/birthDate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A193">
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoPoint"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/comesFromPlace"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isGovernedBy">
    <skos:prefLabel>is governed by</skos:prefLabel>
    <skos:example>A country geo-region is governed by a country government.</skos:example>
    <skos:definition>Relates a thing governed to the governor.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A318">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A476">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/startDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A415">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A105"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A380">
    <owl:someValuesFrom rdf:nodeID="A396"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A6">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A484"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A360">
    <rdf:rest rdf:nodeID="A485"/>
    <rdf:first rdf:nodeID="A301"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A419">
    <owl:allValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/NetworkNode"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/links"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A486">
    <owl:intersectionOf rdf:nodeID="A487"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isIdentifiedBy">
    <skos:prefLabel>is identified by</skos:prefLabel>
    <skos:definition>This is like a URI: a thing can have more than one ID, but each of the IDs must refer to a unique thing.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/ID"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A473">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A400">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasGoal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A465">
    <rdf:rest rdf:nodeID="A118"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/GeoPoint">
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:equivalentClass rdf:nodeID="A253"/>
    <skos:scopeNote>Assume coordinate system used by Google (WGS 84 Web Mercator).</skos:scopeNote>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/IntellectualProperty"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <skos:prefLabel>Geo Point</skos:prefLabel>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <skos:definition>An individual point on the Earth's surface, identified by latitude, longitude and altitude. If altitude is missing, it is assumed to be at the Earth's surface.  However, altitude is measured from sea level.  these points are to the WGS-84 coordinate system using the GPS decimal lat/long</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Place"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Language"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A103">
    <rdf:rest rdf:nodeID="A342"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Organization">
    <skos:scopeNote>There are a plethora of different kinds of organizations that differ along many facets, including members, structure, purpose, legal vs. non-legal, etc.</skos:scopeNote>
    <skos:prefLabel>Organization</skos:prefLabel>
    <skos:example>Legal entities like companies; non-legal entities like clubs, committees, or departments.</skos:example>
    <skos:definition>A generic organization that can be formal or informal, legal or non-legal. It can have members, or not.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/SchemaMetaData"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasPhysicalLocation">
    <skos:scopeNote>This property does not distinguish between things whose locations are stable and those whose locations change over time; e.g., a fire hydrant vs. a car.</skos:scopeNote>
    <skos:prefLabel>has physical location</skos:prefLabel>
    <skos:definition>Relates something to its physical location.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Place"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A437">
    <owl:unionOf rdf:nodeID="A82"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A331">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A217"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ContemporaryEvent">
    <skos:scopeNote>When the event actually ends, it will cease being contemporary.</skos:scopeNote>
    <skos:prefLabel>Contemporary Event</skos:prefLabel>
    <skos:definition>An event that has started but has not yet ended.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A17"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A411">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A379"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/data/gist/_Aspect_mass">
    <skos:prefLabel>mass</skos:prefLabel>
    <skos:editorialNote>This instance has been duplicated from reference data so it can be used in property restrictions.</skos:editorialNote>
    <skos:definition>The aspect mass.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/System">
    <skos:prefLabel>System</skos:prefLabel>
    <skos:definition>A system is an artifact with component parts where the parts contribute to the goal of the system</skos:definition>
    <owl:equivalentClass rdf:nodeID="A234"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Obligation">
    <skos:scopeNote>Obligations will often be governed by some Agreement or Offer.</skos:scopeNote>
    <skos:prefLabel>Obligation</skos:prefLabel>
    <skos:definition>A future commitment from one organization or person to another. Contracts are sets of obligations to do or forbear, or to indemnify or warrant.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A203"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A284">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A38">
    <owl:intersectionOf rdf:nodeID="A140"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A192">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A408"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A272">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A466">
    <rdf:rest rdf:nodeID="A168"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/ContentExpression"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A404">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A483"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A53">
    <rdf:rest rdf:nodeID="A191"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A487">
    <rdf:rest rdf:nodeID="A86"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/CatalogItem"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A471">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasSubtrahend">
    <skos:scopeNote>Commonly used with financial metrics.</skos:scopeNote>
    <skos:prefLabel>has subtrahend</skos:prefLabel>
    <skos:example>In the equation 'profit = revenue - expenses', revenue is an addend and expenses is a subtrahend.</skos:example>
    <skos:definition>Relates an aspect to another aspect that is a subtracted component of it.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/produces">
    <skos:prefLabel>produces</skos:prefLabel>
    <skos:example>A task produces a deliverable.</skos:example>
    <skos:definition>The subject creates the object.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A429">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A199"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Component">
    <skos:prefLabel>Component</skos:prefLabel>
    <skos:definition>A component is an artifact that contributes to a system.  Could be a simple mechanical component, such as the float contributing to the toilet tank maintaining a constant level, or much more complex as in the internet of things.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A477"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A450">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasAddress">
    <skos:prefLabel>has address</skos:prefLabel>
    <skos:example>A brick-and-mortar store has a street address. A person can be contacted electronically via an email address.</skos:example>
    <skos:definition>Relates something to its physical or electronic address.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Address"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A351">
    <owl:hasValue rdf:resource="https://w3id.org/semanticarts/ns/data/gist/_Aspect_mass"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A114">
    <owl:hasValue rdf:resource="https://w3id.org/semanticarts/ns/data/gist/_Aspect_volume"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isBasedOn">
    <skos:prefLabel>is based on</skos:prefLabel>
    <skos:example>A document is based on a document template. A metric computing the average income of a population is based on the metric for individual income.</skos:example>
    <skos:definition>The Object is a foundation for, a starting point for, gave rise to or justifies the Subject</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A87">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/ProductCategory"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isCategorizedBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A35">
    <rdf:rest rdf:nodeID="A37"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isSupersededBy">
    <skos:prefLabel>is superseded by</skos:prefLabel>
    <skos:example>gist:connectedTo gist:isSupersededBy gist:isConnectedTo (renaming with no semantic change).</skos:example>
    <skos:definition>Relates a deprecated term to a term that replaces it, which is either an exact (in the case of simple renaming) or approximate (in the case of renaming and some semantic change) semantic match.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A488">
    <owl:someValuesFrom rdf:nodeID="A197"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ProductSpecification">
    <skos:prefLabel>Product Specification</skos:prefLabel>
    <skos:definition>Offering something which could be physically warehoused or digitally stored.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A486"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A439">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A459"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/requires">
    <skos:scopeNote>This predicate is defined generally enough to encompass a few different meanings of the English word 'requires':&#xD;
&#xD;
		1. To need something or to make something necessary.&#xD;
		2. To order or demand something, or to order someone to do something, especially because of a rule or law.&#xD;
		3. To make it officially necessary for someone to do something.&#xD;
&#xD;
	Implementations requiring a more specific meaning should define subproperties.</skos:scopeNote>
    <skos:prefLabel>requires</skos:prefLabel>
    <skos:example>Humans require air; solar power requires sunshine.</skos:example>
    <skos:definition>The subject needs the object or makes it necessary, mandatory, or compulsory.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isAffectedBy">
    <skos:prefLabel>is affected by</skos:prefLabel>
    <skos:definition>Where the effect came from</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/plannedStartYear">
    <skos:scopeNote>Used for anything with a planned start date where precision of one year is sufficient. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included.</skos:scopeNote>
    <skos:prefLabel>planned start year</skos:prefLabel>
    <skos:example>The automobile manufacturer announced that its full line-up will include only electric cars starting in 2035.</skos:example>
    <skos:example>'2021-01-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The date that something is or was planned to start, with precision of one year.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A484">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasBroader"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/containedText">
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Text"/>
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Tag"/>
    <skos:prefLabel>contained text</skos:prefLabel>
    <skos:example>The string associated with text content.</skos:example>
    <skos:example>The string associated with a tag.</skos:example>
    <skos:definition>A string that is closely associated with an individual.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A355">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A489"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/precedes">
    <skos:scopeNote>Typically this predicate would be used asymmetricallly and irreflexively, but the ontology does not formalize this.</skos:scopeNote>
    <skos:scopeNote>This is the transitive version of gist:precedesDirectly.</skos:scopeNote>
    <skos:scopeNote>The less-than symbol is often used to represent this relation.</skos:scopeNote>
    <skos:prefLabel>precedes</skos:prefLabel>
    <skos:definition>A generic ordering relation indicating that the subject comes before the object.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A231">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A338"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/contributesTo">
    <skos:prefLabel>contributes to</skos:prefLabel>
    <skos:definition>The parts of a system contribute to the goal/ function of the whole system</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/NetworkLink">
    <skos:scopeNote>Each NetworkLink is connected to a NetworkNode via the property 'gist:links' or one of its subproperties.</skos:scopeNote>
    <skos:prefLabel>Network Link</skos:prefLabel>
    <skos:example>A network link may be physical, such as pipes, wired or wireless networks, but may also be a link in a non-physical network, such as organizational structures or social networks.</skos:example>
    <skos:definition>An abstract representation of the connection between two or more nodes in a network.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A467"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A442">
    <owl:intersectionOf rdf:nodeID="A132"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDate">
    <skos:scopeNote>Used for things where the precision of a date is sufficient, such as most projects, tasks, and the like. Recommended usage is to zero out the hours through microseconds to avoid spurious precision.</skos:scopeNote>
    <skos:prefLabel>actual end date</skos:prefLabel>
    <skos:example>'2021-06-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual date that something ended, with precision of one day.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
