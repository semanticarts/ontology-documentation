    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasBiologicalParent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A98">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasGoal">
    <skos:prefLabel>has goal</skos:prefLabel>
    <skos:definition>The reason for doing something</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A275">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Place"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/refersTo"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/MediaType">
    <skos:scopeNote>The unique text for an IANA media type is the concatenation of the 'Type name', a slash '/', and the 'Subtype name' as provided on the page displayed when you resolve the URI of the media type.</skos:scopeNote>
    <skos:prefLabel>Media Type</skos:prefLabel>
    <skos:example>application/sparql-results+xml</skos:example>
    <skos:definition>A digitized type that computer applications can recognize.</skos:definition>
    <rdfs:seeAlso rdf:resource="https://www.iana.org/assignments/media-types/media-types.xhtml"/>
    <rdfs:subClassOf rdf:nodeID="A108"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A259">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isRenderedOn">
    <skos:prefLabel>is rendered on</skos:prefLabel>
    <skos:definition>What media something was rendered On</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Language">
    <skos:prefLabel>Language</skos:prefLabel>
    <skos:example>Natural languages such as English and Spanish; computer languages such as OWL, Python, and XML.</skos:example>
    <skos:definition>A recognized, organized set of symbols and grammar.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Person">
    <skos:prefLabel>Person</skos:prefLabel>
    <skos:example>Negative example:fictional characters.</skos:example>
    <skos:definition>A human being that may or may not still be alive.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A276"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A277">
    <rdf:rest rdf:nodeID="A278"/>
    <rdf:first rdf:nodeID="A279"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/license">
    <skos:prefLabel>license</skos:prefLabel>
    <skos:definition>An annotation for providing the licensing on this or derivative ontologies</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A189">
    <rdf:rest rdf:nodeID="A280"/>
    <rdf:first rdf:nodeID="A2"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A281">
    <rdf:rest rdf:nodeID="A282"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfOther">
    <skos:scopeNote>Set the value to 0 if the units of measure in the unit group can be expressed using the standard set of exponents (as in the examples).&#xD;
&#xD;
		Otherwise set the value to 1, which typically means the units of measure in the group use a logarithmic scale.</skos:scopeNote>
    <skos:prefLabel>exponent of other</skos:prefLabel>
    <skos:example>Decibel, pH, and octave are units of measure that are logarithmic. Their unit groups have exponent of other = 1.</skos:example>
    <skos:definition>Indicates whether a unit of measure can be expressed in terms of the standard exponents (as shown in the examples).</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A212"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A283">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:cardinality>
    <owl:onProperty rdf:nodeID="A284"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A285">
    <owl:intersectionOf rdf:nodeID="A286"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A287">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A125"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A288">
    <rdf:rest rdf:nodeID="A250"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A289">
    <owl:intersectionOf rdf:nodeID="A290"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/startDateTime">
    <skos:scopeNote>Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.</skos:scopeNote>
    <skos:scopeNote>This property is neutral along two dimensions: precision (e.g., day, second, millisecond) and actual vs. planned. As such, it will generally not be asserted directly except in special cases (e.g., for time intervals).</skos:scopeNote>
    <skos:prefLabel>start date time</skos:prefLabel>
    <skos:definition>The date and time that something starts.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/atDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualStartMinute">
    <skos:scopeNote>Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.</skos:scopeNote>
    <skos:prefLabel>actual start minute</skos:prefLabel>
    <skos:example>'2021-06-01T08:32:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual date and time that something started, with precision of one minute.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A291">
    <owl:intersectionOf rdf:nodeID="A292"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ControlledVocabulary">
    <skos:prefLabel>Controlled Vocabulary</skos:prefLabel>
    <skos:definition>A collection of terms approved and managed by some organization or person.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A293"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Restriction">
    <skos:prefLabel>Restriction</skos:prefLabel>
    <skos:definition>A description of things one is prevented from doing.  Most laws are restrictions.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A289"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasUnitOfMeasure">
    <skos:prefLabel>has unit of measure</skos:prefLabel>
    <skos:definition>The magnitude 87 inches of height has unit of measure inches.</skos:definition>
    <skos:definition>Relates a magnitude to a unit of measure.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A294">
    <rdf:rest rdf:nodeID="A295"/>
    <rdf:first rdf:nodeID="A296"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/precedesDirectly">
    <skos:scopeNote>Typically this predicate would be used asymmetricallly and irreflexively, but the ontology does not formalize this.</skos:scopeNote>
    <skos:scopeNote>It is safest to use this property only when the directness has a semantic correspondence with the world. Only break a direct link by inserting an intermediate item when that change corresponds to a change in the world.</skos:scopeNote>
    <skos:scopeNote>If two items in an ordered collection share the same position, they both directly precede the following element.</skos:scopeNote>
    <skos:prefLabel>precedes directly</skos:prefLabel>
    <skos:definition>A generic ordering relation indicating that the subject comes immediately before the object.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/precedes"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A297">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A220"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure">
    <skos:prefLabel>Unit of Measure</skos:prefLabel>
    <skos:example>An acre is a unit for measuring area.</skos:example>
    <skos:definition>A standard amount used to measure or specify things.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A298">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/plannedEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A299">
    <rdf:rest rdf:nodeID="A300"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/CatalogItem"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A301">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoRegion"/>
    <owl:onProperty rdf:nodeID="A252"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A302">
    <rdf:rest rdf:nodeID="A303"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A304">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/OrderedMember"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/precedesDirectly"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A305">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoSegment"/>
    <owl:onProperty rdf:nodeID="A306"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime">
    <skos:scopeNote>This is an abstraction over the various precisions of actual end time, and is not expected to be asserted directly. Values of predicates with different precisions can be compared since they are all formally xsd:datetimes.</skos:scopeNote>
    <skos:prefLabel>actual end date time</skos:prefLabel>
    <skos:definition>The actual date and time that something ended, with no implied precision.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/endDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A307">
    <rdf:rest rdf:nodeID="A164"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#definition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A308">
    <rdf:rest rdf:nodeID="A309"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Account">
    <skos:prefLabel>Account</skos:prefLabel>
    <skos:definition>An agreement having a balance, as in a bank account, or credit card account, or Accounts Receivable account.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A310"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A266">
    <rdf:rest rdf:nodeID="A311"/>
    <rdf:first rdf:nodeID="A312"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/EventSpecification">
    <skos:scopeNote>This concept is useful for risk assessment and insurance policies.</skos:scopeNote>
    <skos:prefLabel>Event Specification</skos:prefLabel>
    <skos:example>An insurance company defines the characteristics of a weather event that must be satisfied for it to qualify as a hail storm covered in its homeowner's policy. Defaulting on a loan.</skos:example>
    <skos:definition>A characterization of an event that might happen.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Specification"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isCategorizedBy">
    <gist:rangeIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <skos:prefLabel>is categorized by</skos:prefLabel>
    <skos:definition>Points to a taxonomy item or other less formally defined class.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Determination">
    <skos:prefLabel>Determination</skos:prefLabel>
    <skos:example>Measuring the sulphur content of crude oil. Evaluating a loan application for approval. Estimating the price of gas for the next three months. Determining whether and by how much an interest rate should change. Classifying something.</skos:example>
    <skos:definition>An event whose purpose is to establish a specific result, value, or outcome, usually by research, measuring, evaluating, or calculating.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A313">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A263"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A282">
    <rdf:rest rdf:nodeID="A314"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A315">
    <rdf:rest rdf:nodeID="A316"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Agreement">
    <skos:prefLabel>Agreement</skos:prefLabel>
    <skos:definition>Something which two or more People or Organizations mutually commit to do.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A291"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/domainIncludes">
    <skos:scopeNote>This property is used to guide the ontology user; like all annotation properties, it does not play a role in inference.</skos:scopeNote>
    <skos:scopeNote>There may be multiple domainIncludes assertions on a single property.</skos:scopeNote>
    <skos:prefLabel>domain includes</skos:prefLabel>
    <skos:example>The domain of the property gist:containedText includes gist:Tag and gist:Text.</skos:example>
    <skos:definition>Relates a property to a class that the property is expected to be used on.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A317">
    <rdf:rest rdf:nodeID="A318"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A319">
    <owl:someValuesFrom rdf:nodeID="A320"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasGiver"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A1">
    <rdf:rest rdf:nodeID="A207"/>
    <rdf:first rdf:nodeID="A321"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/GeoRoute">
    <skos:prefLabel>Geo Route</skos:prefLabel>
    <skos:definition>An ordered set of GeoPoints that defines a path from starting point to ending point.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A322"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A322">
    <owl:intersectionOf rdf:nodeID="A323"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A151">
    <rdf:rest rdf:nodeID="A137"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A142">
    <owl:unionOf rdf:nodeID="A45"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualEndYear">
    <skos:scopeNote>Used for things where the precision of a year is sufficient. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included.</skos:scopeNote>
    <skos:prefLabel>actual end year</skos:prefLabel>
    <skos:example>The tenure of the previous chairman of the board ended in 2021.</skos:example>
    <skos:example>'2021-01-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual date that something ended, with precision of one year.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A324">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A325"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/data/gist/_Aspect_probability">
    <skos:prefLabel>probability</skos:prefLabel>
    <skos:editorialNote>This instance has been duplicated from reference data so it can be used in property restrictions.</skos:editorialNote>
    <skos:definition>The aspect probability.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A326">
    <owl:unionOf rdf:nodeID="A302"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A327">
    <owl:intersectionOf rdf:nodeID="A156"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/birthDate">
    <skos:scopeNote>This is a subproperty of gist:startDateTime rather than gist:actualStartDate because some living things have yet to be born. This property refers to a calendar date and is assumed to precision of one day (time zone offset is allowed). It is recommended to zero out the hours through microseconds to avoid spurious precision. Implementations requiring a birthdate to the minute can define a subproperty.</skos:scopeNote>
    <skos:prefLabel>birth date</skos:prefLabel>
    <skos:example>'2021-06-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The date some living thing was or will be born, with precision of one day.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/startDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isPartOf">
    <skos:scopeNote>The transitive version of gist:isDirectPartOf.</skos:scopeNote>
    <skos:scopeNote>Because the part has independent existence, there is no cascading delete.</skos:scopeNote>
    <skos:prefLabel>is part of</skos:prefLabel>
    <skos:definition>The relationship between a part and a whole where the part has independent existence.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A213">
    <rdf:rest rdf:nodeID="A328"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A119">
    <owl:hasValue rdf:resource="https://w3id.org/semanticarts/ns/data/gist/_Aspect_monetary_value"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A329">
    <owl:intersectionOf rdf:nodeID="A330"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A295">
    <rdf:rest rdf:nodeID="A331"/>
    <rdf:first rdf:nodeID="A43"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A332">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <owl:onProperty rdf:nodeID="A333"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A256">
    <rdf:rest rdf:nodeID="A230"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Collection"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Transaction">
    <skos:scopeNote>Different sorts of transactions can have different datetime precisions. For example, an electronic transaction would have a gist:actualEndMicrosecond.</skos:scopeNote>
    <skos:prefLabel>Transaction</skos:prefLabel>
    <skos:definition>An exchange or transfer of goods, services, or funds.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A245">
    <owl:unionOf rdf:nodeID="A308"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A153">
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Obligation"/>
    <owl:onProperty rdf:nodeID="A144"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A248">
    <rdf:rest rdf:nodeID="A273"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isGeoContainedIn">
    <skos:prefLabel>is geographically contained in</skos:prefLabel>
    <skos:definition>Relates one place to another that contains it.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Place"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Place"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A316">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A334"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/plannedEndMinute">
    <skos:scopeNote>Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual.</skos:scopeNote>
    <skos:prefLabel>planned end minute</skos:prefLabel>
    <skos:example>'2021-06-01T08:32:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The date and time that something is or was planned to end, with precision of one minute.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/plannedEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A278">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A283"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Task">
    <skos:scopeNote>Use the property isBasedOn to link a Task back to the TaskTemplate.</skos:scopeNote>
    <skos:scopeNote>Something that could potentially be executed, which is merely described but not proposed in any specific way, such as a business process for onboarding a new employee, or the steps in a recipe for making polyethylene from ethylene, is not a task but rather a task template.</skos:scopeNote>
    <skos:prefLabel>Task</skos:prefLabel>
    <skos:definition>A piece of work that is either proposed, planned, scheduled, underway, or completed.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A150"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A89">
    <rdf:rest rdf:nodeID="A335"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A336">
    <owl:unionOf rdf:nodeID="A337"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A338">
    <owl:allValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/OrderedMember"/>
    <owl:onProperty rdf:nodeID="A339"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A340">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A341"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A342">
    <rdf:rest rdf:nodeID="A343"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A344">
    <owl:intersectionOf rdf:nodeID="A345"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A346">
    <rdf:rest rdf:nodeID="A242"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A347">
    <owl:intersectionOf rdf:nodeID="A288"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/conformsTo">
    <gist:rangeIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
    <skos:prefLabel>conforms to</skos:prefLabel>
    <skos:definition>The subject conforms to the Object, e.g. meet an obligation, meet terms of an offer, adhere to a specification</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A348">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A180"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/CatalogItem">
    <skos:scopeNote>In short, an unambiguous characterization of what it is that a potential buyer is paying for.</skos:scopeNote>
    <skos:prefLabel>Catalog Item</skos:prefLabel>
    <skos:definition>A description of a product or service to be delivered, given in a sufficient level of detail that a receiver could determine whether delivery constituted discharge of the obligation to deliver.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Specification"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/EquipmentType">
    <skos:prefLabel>Equipment Type</skos:prefLabel>
    <skos:definition>Categories of equipment</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isConnectedTo">
    <skos:prefLabel>is connected to</skos:prefLabel>
    <skos:definition>A non-owning, non-causal, non-subordinate (i.e., peer-to-peer) relationship.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A204">
    <rdf:rest rdf:nodeID="A349"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Content"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A246">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Component"/>
    <owl:onProperty rdf:nodeID="A104"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A350">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A351"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A352">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A353">
    <owl:intersectionOf rdf:nodeID="A354"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A303">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalAddressType">
    <skos:prefLabel>Physical Address Type</skos:prefLabel>
    <skos:example>Street address, PO box, FPO code.</skos:example>
    <skos:definition>A category indicating local customary characterizations of physical addresses.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Project">
    <skos:prefLabel>Project</skos:prefLabel>
    <skos:example>Designing an insurance product, adding a new feature to a software application, assessing the level of risk for a mortgage application.</skos:example>
    <skos:definition>A task, usually of longer duration, made up of other tasks.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A285"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A354">
    <rdf:rest rdf:nodeID="A80"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Artifact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/OrderedMember">
    <skos:scopeNote>An ordered member points to the real world item via the providesOrderFor property. Ordering information is represented either as a number in a sequence, or by preceding or following another ordered member.</skos:scopeNote>
    <skos:prefLabel>Ordered Member</skos:prefLabel>
    <skos:example>A person may rank 12th in the Boston Marathon but 29th in the New York City Marathon.</skos:example>
    <skos:definition>A member of an ordered collection serving as a proxy for a real world item, which can appear in different orders in different collections. The ordered member appears in exactly one ordered collection.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A133"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A29">
    <rdf:rest rdf:nodeID="A281"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A198">
    <rdf:rest rdf:nodeID="A355"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A335">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/symbol">
    <gist:domainIncludes rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <skos:prefLabel>symbol</skos:prefLabel>
    <skos:example>The ASCII symbol for square meter is m^2.</skos:example>
    <skos:definition>A symbol for something using only ASCII characters.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A148">
    <owl:intersectionOf rdf:nodeID="A269"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A356">
    <rdf:rest rdf:nodeID="A357"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Address"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/GeoRegion">
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Language"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
    <skos:example>The bounded shape that defines the region occupied by Crater Lake; the bounded area known as the contiguous USA.</skos:example>
    <skos:definition>A bounded region (or set of regions) on the surface of the Earth.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <skos:scopeNote>A GeoRegion could be non-contiguous; e.g. the region governed by the USA is the region governed by the lower 48 states plus that of Alaska and Hawaii.  Child classes in lower ontologies can make this distinction.</skos:scopeNote>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/IntellectualProperty"/>
    <rdfs:subClassOf rdf:nodeID="A358"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Template"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <skos:prefLabel>Geo Region</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A312">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A359">
    <rdf:rest rdf:nodeID="A360"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GovernmentOrganization"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasUniqueBroader">
    <skos:prefLabel>has unique broader</skos:prefLabel>
    <skos:definition>Relates a thing to a unique other thing with a broader meaning.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasBroader"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A361">
    <owl:intersectionOf rdf:nodeID="A362"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Discipline">
    <skos:prefLabel>Discipline</skos:prefLabel>
    <skos:example>Finance, accounting, project management, acoustics, ballistics, etc.</skos:example>
    <skos:definition>An area of study or practice, such as accounting.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/sequence">
    <skos:prefLabel>sequence</skos:prefLabel>
    <skos:definition>For ordering ordered lists.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A363">
    <owl:someValuesFrom rdf:nodeID="A99"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A364">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:onProperty rdf:nodeID="A177"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A365">
    <owl:unionOf rdf:nodeID="A307"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/providesOrderFor">
    <skos:prefLabel>provides order for</skos:prefLabel>
    <skos:definition>Links a member of an ordered collection to the real-world item it represents in that collection.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/OrderedMember"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualStartDate">
    <skos:scopeNote>Used for things where the precision of a date is sufficient, such as most projects, tasks, and the like. Recommended usage is to zero out the hours through microseconds to avoid spurious precision.</skos:scopeNote>
    <skos:prefLabel>actual start date</skos:prefLabel>
    <skos:example>'2021-06-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual date that something started, with precision of one day.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A160">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/containedText"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A366">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A367"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Message">
    <skos:prefLabel>Message</skos:prefLabel>
    <skos:example>An email message, a phone call, a voice message, or a Web Service message.</skos:example>
    <skos:definition>A specific instance of content sent from a sender to at least one other recipient.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A115"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A368">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A369">
    <owl:intersectionOf rdf:nodeID="A370"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A345">
    <rdf:rest rdf:nodeID="A324"/>
    <rdf:first rdf:nodeID="A371"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfKilogram">
    <skos:prefLabel>exponent of kilogram</skos:prefLabel>
    <skos:example>In the equation '1 millimole per gram = 1 x mole per kilogram'&#xD;
&#xD;
		the conversion factor for millimole per gram is 1&#xD;
		the exponent of mole is 1&#xD;
		the exponent of kilogram is -1&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing millimole per gram must be a multiple of mole per kilogram.</skos:example>
    <skos:definition>The exponent of kilogram in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A372"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ElectronicAddress">
    <skos:prefLabel>Electronic Address</skos:prefLabel>
    <skos:example>A path to a file in a file system, a website URL, an IP address, an email address, a mobile or landline telephone number.</skos:example>
    <skos:definition>An address referring to a locatable virtual place that does not physically exist but is made by software or electronics to appear to do so.</skos:definition>
    <skos:altLabel>Virtual Address</skos:altLabel>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalAddress"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Address"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A265">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A314">
    <rdf:rest rdf:nodeID="A373"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualEndMinute">
    <skos:scopeNote>Used for things like meetings and time card entries, where the hour and minute are important. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.</skos:scopeNote>
    <skos:prefLabel>actual end minute</skos:prefLabel>
    <skos:example>'2021-06-01T08:32:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual date and time that something ended, with precision of one minute.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Content">
    <skos:definition>A document, program, image, etc.  (Categories are not content until they are written down.)</skos:definition>
    <skos:prefLabel>Content</skos:prefLabel>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoRegion"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoPoint"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Artifact"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/description">
    <skos:scopeNote>This property is used to provide a description of an individual in greater detail than a label.</skos:scopeNote>
    <skos:prefLabel>description</skos:prefLabel>
    <skos:example>The Empire State Building is a 102-story Art Deco skyscraper in Midtown Manhattan in New York City, United States. It was designed by Shreve, Lamb &amp; Harmon and built from 1930 to 1931.</skos:example>
    <skos:definition>A statement about someone or something's attributes or characteristics.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Collection">
    <skos:scopeNote>Individuals are placed in the collection using the gist:isMemberOf property. Collections typically are created because the members are functionally connected in some way. This definition allows a collection to have zero members.</skos:scopeNote>
    <skos:prefLabel>Collection</skos:prefLabel>
    <skos:example>A jury is a group of people, a financial ledger is a collection of transaction entries; a route is an (ordered) collection of segments.</skos:example>
    <skos:definition>A grouping of things.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Aspect">
    <skos:scopeNote>Every aspect should be related to a broader aspect or to a unit group. For example, angle of incidence should be related to the broader concept of angle, which in turn is related to a unit group.</skos:scopeNote>
    <skos:prefLabel>Aspect</skos:prefLabel>
    <skos:definition>A measurable characteristic such as length, weight, cost, cycle time, or defect rate.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A374">
    <rdf:rest rdf:nodeID="A223"/>
    <rdf:first rdf:nodeID="A375"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualEndMicrosecond">
    <skos:scopeNote>A system time will be as precise as the system can supply, typically at least milliseconds, sometimes microseconds. The convention for timestamps, such as recording a transaction, is to specify just the end point; the start time is rarely needed.</skos:scopeNote>
    <skos:prefLabel>actual end microsecond</skos:prefLabel>
    <skos:example>'2021-06-01T08:03:27.12324-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual time that something ended, expressed as a system time used for timestamps.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualEndDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ReferenceValue">
    <skos:prefLabel>Reference Value</skos:prefLabel>
    <skos:definition>A measure that was neither measured nor estimated but set by fiat. For instance, a goal. There is no measurement associated with a reference value.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalActionType">
    <skos:prefLabel>Physical Action Type</skos:prefLabel>
    <skos:definition>The effects to be realized in the real world, such as lifting a garage door, turning off a valve, dropping cadmium rods, etc.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A370">
    <rdf:rest rdf:nodeID="A376"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Template"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A377">
    <rdf:rest rdf:nodeID="A146"/>
    <rdf:first rdf:nodeID="A378"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A357">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A275"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A379">
    <owl:someValuesFrom rdf:nodeID="A336"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/goesToAgent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A94">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/precedesDirectly"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A228">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A380"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isAbout">
    <skos:prefLabel>is about</skos:prefLabel>
    <skos:definition>Subject matter of a document.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Content"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A232">
    <owl:unionOf rdf:nodeID="A277"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A381">
    <owl:unionOf rdf:nodeID="A271"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A131">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isPartOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/allows">
    <skos:prefLabel>allows</skos:prefLabel>
    <skos:definition>The intention (say a grant) allows a particular kind of activity (for instance egress)</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A382">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Language"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isExpressedIn"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualStartYear">
    <skos:scopeNote>Used for things where the precision of a year is sufficient. Recommended usage is to zero out the hours through microseconds to avoid spurious precision. Note that it is not valid to zero out months and days, so arbitrary values must be included.</skos:scopeNote>
    <skos:prefLabel>actual start year</skos:prefLabel>
    <skos:example>The tenure of the current chairman of the board began in 2021.</skos:example>
    <skos:example>'2021-01-01T00:00:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual date that something started, with precision of one year.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A383">
    <rdf:rest rdf:nodeID="A152"/>
    <rdf:first rdf:nodeID="A384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Intention">
    <skos:prefLabel>Intention</skos:prefLabel>
    <skos:definition>Goal, desire, aspiration. This is the "teleologic" aspect of the system that indicates things are done with a purpose.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A385">
    <rdf:rest rdf:nodeID="A386"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A387">
    <rdf:rest rdf:nodeID="A388"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Collection"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A389">
    <rdf:rest rdf:nodeID="A350"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A22">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A305"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A390">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoVolume"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Template">
    <skos:scopeNote>Use gist:isBasedOn to link the object made from the template back to the template.</skos:scopeNote>
    <skos:prefLabel>Template</skos:prefLabel>
    <skos:example>Cookie cutters are templates for cookies.</skos:example>
    <skos:example>A form. A filled-in form has the structure of the form with data entered into some or all of the fields.</skos:example>
    <skos:example>A die in manufacturing that is used to make stamped parts. </skos:example>
    <skos:definition>Something used to make objects in its own image.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A239">
    <owl:intersectionOf rdf:nodeID="A77"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A378">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasUnitOfMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A391">
    <owl:unionOf rdf:nodeID="A392"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A393">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/CatalogItem"/>
    <owl:onProperty rdf:nodeID="A145"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasGiver">
    <skos:prefLabel>has giver</skos:prefLabel>
    <skos:definition>The active party, the one with the obligation or the one initiating the transfer</skos:definition>
    <owl:propertyDisjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasRecipient"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A176">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isTriggeredBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A394">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A395"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A396">
    <owl:intersectionOf rdf:nodeID="A72"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A172">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://www.w3.org/2002/07/owl#real"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance">
    <skos:scopeNote>This concept generally corresponds to mass nouns in English. By contrast, instances of PhysicalIdentifiableItem, such as a computer, book, or car, are count nouns. PhysicalIdentifiableItems are made up of PhysicalSubstances; e.g., a cake is made up of butter, flour, and sugar; a ring is made of gold. If you divide a PhysicalSubstance such as an amount of water into parts, you have different amounts of water otherwise indistinguishable from one another; if you divide a PhysicalIdentifiableItem such as a computer into parts, each part will be distinguishable from the original whole.</skos:scopeNote>
    <skos:scopeNote>An instance of this class has weight and takes up space. We mean the physical gold in a ring, not the concept of gold that shows up in the periodic table.</skos:scopeNote>
    <skos:prefLabel>Physical Substance</skos:prefLabel>
    <skos:example>An amount of water, penicillin, sand, gold: an actual piece of gold, not the concept of gold.</skos:example>
    <skos:definition>An undifferentiated amount of physical material which, when subdivided, results in each part being indistinguishable in nature from the whole and from every other part.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <rdfs:subClassOf rdf:nodeID="A397"/>
    <rdfs:subClassOf rdf:nodeID="A210"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A226">
    <owl:intersectionOf rdf:nodeID="A398"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A399">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasBroader"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A376">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A400"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/accepts">
    <skos:prefLabel>accepts</skos:prefLabel>
    <skos:definition>The types of input messages that will be allowed.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A375">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/latitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A401">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Place"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A402">
    <owl:someValuesFrom rdf:nodeID="A329"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/HistoricalEvent">
    <skos:prefLabel>Historical Event</skos:prefLabel>
    <skos:definition>An event which occurred in time, with an actual end earlier than the present moment.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A361"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ContingentEvent">
    <skos:prefLabel>Contingent Event</skos:prefLabel>
    <skos:example>The death benefit payout on a life insurance policy following the death of a specific person.</skos:example>
    <skos:example>Sell 20 shares of stock in a given company when the price drops below $200/share.</skos:example>
    <skos:example>Fire insurance is contingent on a particular building burning down</skos:example>
    <skos:definition>An event with a probability of happening in the future, and usually dependent upon some other event or condition.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A327"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A403">
    <rdf:rest rdf:nodeID="A404"/>
    <rdf:first rdf:nodeID="A274"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#example">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A241">
    <owl:intersectionOf rdf:nodeID="A9"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A405">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/SubCountryGovernment">
    <skos:scopeNote>This class applies only to organizations governing geo-regions. Regulatory and bureaucratic organizations are members of the more generic GovernmentOrganization class.</skos:scopeNote>
    <skos:scopeNote>Note that the predicate 'governs' is used both for the relationship a government has to a governed geo-region, and for the relationship one government has to the governments of its sub-regions.</skos:scopeNote>
    <skos:scopeNote>Across the world, there are a variety of types of subsections of a country and the governments thereof (as well as different terms, like 'province' and 'state', which refer to essentially the same type of thing). We should not automatically assume 'state', 'county', and 'city'.  It is more future-proof just to mint the instances using the generic SubCountryGovernment and, where greater specificity is needed, define categories or subclasses.</skos:scopeNote>
    <skos:prefLabel>Sub-Country Government</skos:prefLabel>
    <skos:definition>A government of a governed geo-region other than a country, which is under the direct or indirect control of a country government.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A406"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/actualStartMicrosecond">
    <skos:scopeNote>A system time will be as precise as the system can supply, typically at least milliseconds, sometimes microseconds. The convention for timestamps, such as recording a transaction, is to specify just the end point; the start time is rarely needed. This property is defined for the cases when you do need to capture the runtime of a system process, and is then used in conjunction with gist:actualEndMicrosecond.</skos:scopeNote>
    <skos:prefLabel>actual start microsecond</skos:prefLabel>
    <skos:example>'2021-06-01T08:03:27.12324-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The actual time that something started, expressed as a system time used for timestamps.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/actualStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude">
    <skos:prefLabel>Magnitude</skos:prefLabel>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <skos:example>A model of car could have a wheelbase of 113.2 inches. In this example, the aspect is wheelbase, the unit of measure is inch, and the numeric value is 113.2.</skos:example>
    <rdfs:seeAlso rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAccuracy"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalIdentifiableItem"/>
    <owl:equivalentClass rdf:nodeID="A407"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitOfMeasure"/>
    <skos:definition>The amount of a measurable characteristic (aspect).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:scopeNote>An accuracy can be assigned to a magnitude using the property has accuracy.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A408">
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoPoint"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/goesToPlace"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A409">
    <owl:unionOf rdf:nodeID="A410"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A257">
    <rdf:rest rdf:nodeID="A411"/>
    <rdf:first rdf:nodeID="A51"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A412">
    <rdf:rest rdf:nodeID="A209"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A166">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeneralMediaType"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isCategorizedBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A395">
