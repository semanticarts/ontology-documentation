    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Behavior"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/prevents"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A80">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A81"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/GovernmentOrganization">
    <skos:scopeNote>Includes administrative, regulatory, and enforcement organizations created or sanctioned by Country or SubCountry Governments.</skos:scopeNote>
    <skos:prefLabel>Government Organization</skos:prefLabel>
    <skos:example>The State of Washington Office of Financial Management; the Food and Drug Administration; the Scottish Parliament.</skos:example>
    <skos:definition>An organization which exercises political and/or regulatory authority over a political unit, people, geo-region, etc., as well as performing certain functions for this unit or body. Differs from a corporation in that it cannot be owned.</skos:definition>
    <owl:disjointWith rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/IntergovernmentalOrganization"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A82">
    <rdf:rest rdf:nodeID="A83"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/UnitGroup"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A84">
    <owl:unionOf rdf:nodeID="A85"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A86">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A87"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A88">
    <rdf:rest rdf:nodeID="A89"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/IntellectualProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ElectronicAddressType">
    <skos:prefLabel>Electronic Address Type</skos:prefLabel>
    <skos:example>URL, file system path, email address, mobile telephone number.</skos:example>
    <skos:definition>A category indicating a kind of electronic address. Such a category is usually based on the technology that enables routing to the address referent.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A90">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/goesToAgent">
    <skos:scopeNote>This is not the inverse of gist:comesFromAgent. A message can be from someone. If we made it the inverse the person would be "to" the message</skos:scopeNote>
    <skos:prefLabel>goes to agent</skos:prefLabel>
    <skos:definition>The party that is the recipient of something (e.g. a message, shipment, etc.)</skos:definition>
    <rdfs:range rdf:nodeID="A32"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
