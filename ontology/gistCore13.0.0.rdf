  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasNavigationalParent">
    <skos:prefLabel>has navigational parent</skos:prefLabel>
    <skos:example>Refrigerator handles are not refrigerators, but it may be useful to represent their relationship hierarchically for a faceted UI filter.</skos:example>
    <skos:definition>Relates a child category to a parent category in an informal (e.g., faceted) hierarchy.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ontology/gistCore">
    <gist:license>https://creativecommons.org/licenses/by/4.0/</gist:license>
    <skos:prefLabel>gist</skos:prefLabel>
    <skos:historyNote>&#xD;
        gist 13.0.0 released 2024-Jul-19.&#xD;
        gist 12.1.0 released 2024-Feb-27.&#xD;
        gist 12.0.1 released 2023-Jul-28.&#xD;
        gist 12.0.0 released 2023-Jul-05.&#xD;
        gist 11.1.0 released 2022-Oct-10.&#xD;
        gist 11.0.0 released 2022-Apr-11.&#xD;
	</skos:historyNote>
    <skos:definition>gist is a minimalist upper ontology created by Semantic Arts.</skos:definition>
    <owl:versionIRI rdf:resource="https://w3id.org/semanticarts/ontology/gistCoreX.x.x"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/BundledCatalogItem">
    <skos:prefLabel>Bundled Catalog Item</skos:prefLabel>
    <skos:definition>Any combination of descriptions of things offered together.  Could be a kit (several parts offered together), but could also be a product plus a warranty.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A219"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfKelvin">
    <skos:prefLabel>exponent of Kelvin</skos:prefLabel>
    <skos:example>In the equation 'y degrees Fahrenheit = (y + 459.6669607) x 5/9 degrees Kelvin'&#xD;
&#xD;
		the conversion offset for degree Fahrenheit is 459.6669607&#xD;
		the conversion factor for degree Fahrenheit is 5/9&#xD;
		the exponent of Kelvin is 1&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing degree Fahrenheit will have a similar equation, with different offset or conversion factor (or both).</skos:example>
    <skos:definition>The exponent of Kelvin in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A365"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A42">
    <rdf:rest rdf:nodeID="A390"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/GeoRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfMeter">
    <skos:prefLabel>exponent of meter</skos:prefLabel>
    <skos:example>In the equation '1 microgram per milliliter = 0.001 x kilogram per meterCubed'&#xD;
&#xD;
		the conversion factor for microgram per milliliter is 0.001&#xD;
		the exponent of kilogram is 1&#xD;
		the exponent of meter is -3&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing microgram per milliliter must be a multiple of kilogram per meterCubed.</skos:example>
    <skos:definition>The exponent of meter in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A74"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A182">
    <owl:hasValue rdf:resource="https://w3id.org/semanticarts/ns/data/gist/_Aspect_financial_balance"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasAspect"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
