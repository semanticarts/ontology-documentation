    <rdf:rest rdf:nodeID="A56"/>
    <rdf:first rdf:resource="http://www.w3.org/2001/XMLSchema#negativeInteger"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Taxonomy">
    <skos:prefLabel>Taxonomy</skos:prefLabel>
    <skos:definition>A controlled vocabulary arranged as a hierarchy of concepts.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A457"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A59">
