  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/AddressUsageType">
    <skos:scopeNote>If you are using temporal relations involving addresses, this category should be used to qualify the temporal relation rather than the address itself, since the same address may have different uses in different contexts, by different people and organizations, or at different times.</skos:scopeNote>
    <skos:prefLabel>Address Usage Type</skos:prefLabel>
    <skos:example>Billing, business, personal, postal, residence.</skos:example>
    <skos:definition>A category indicating the context or manner in which an address may be used.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/LivingThing">
    <skos:scopeNote>Not all life forms have exactly two parents, so the restriction only specifies a minimum of one.</skos:scopeNote>
    <skos:prefLabel>Living Thing</skos:prefLabel>
    <skos:example>Negative examples: fictional life forms such as unicorns or Mickey Mouse.</skos:example>
    <skos:example>A cat, a mushroom, a tree.</skos:example>
    <skos:definition>Something that is currently, or at some point in time was, alive.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A30"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
