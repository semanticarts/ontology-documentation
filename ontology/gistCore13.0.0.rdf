  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/isRecordedAt">
    <skos:scopeNote>Precision may vary according to context.</skos:scopeNote>
    <skos:prefLabel>is recorded at</skos:prefLabel>
    <skos:definition>Date that something was posted, not necessarily the date it occurred. Must be after the date of occurrence, but could be before or after the planned date. (Unusual, but I could record today that I expected to be paid last week.)</skos:definition>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/atDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
