  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/prevents">
    <skos:prefLabel>prevents</skos:prefLabel>
    <skos:definition>The intention (say a law) is intended to prevent this kind of behavior (say jay-walking)</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Behavior"/>
    <rdfs:domain rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Intention"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/links">
    <skos:prefLabel>links</skos:prefLabel>
    <skos:definition>Relates a NetworkLink to a NetworkNode that it connects to another node. Used when the connections are undirected, or the direction is not known.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
