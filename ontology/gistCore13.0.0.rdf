  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Medium">
    <skos:prefLabel>Medium</skos:prefLabel>
    <skos:definition>A physicality on which a work could be implemented or exposed. E.g., paper, clay, or a computer monitor.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Category"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A73">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A182"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/refersTo">
    <skos:prefLabel>refers to</skos:prefLabel>
    <skos:definition>Relates something to another resource that it points to, indicates, or references.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ID">
    <skos:scopeNote>This is used in conjunction with gist:isIdentifiedBy</skos:scopeNote>
    <skos:prefLabel>ID</skos:prefLabel>
    <skos:example>SSN for a person; serial number for a product; employee ID.</skos:example>
    <skos:definition>Content that is used to uniquely identify something or someone.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A183"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A184">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A185"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A186">
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minCardinality>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A169">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="A187"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/occursIn">
    <skos:prefLabel>occurs in</skos:prefLabel>
    <skos:definition>The geospatial place where something happened or will happen</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
