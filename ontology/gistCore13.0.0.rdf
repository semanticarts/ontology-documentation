  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/exponentOfRadian">
    <skos:prefLabel>exponent of radian</skos:prefLabel>
    <skos:example>In the equation '1 revolution = 6.283 x radian'&#xD;
&#xD;
		the conversion factor for revolution is 6.283&#xD;
		the exponent of radian is 1&#xD;
		all other exponents are zero&#xD;
&#xD;
		Every member of a unit group containing revolution must be a multiple of radian.</skos:example>
    <skos:definition>The exponent of radian in a product of powers of base units.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:nodeID="A52"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
