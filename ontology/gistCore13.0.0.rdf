  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/plannedStartMinute">
    <skos:scopeNote>Used for things like meetings and time card entries, where the hour and minute are important. Typically a planned date is in the future when first captured, but when tasks run late, we leave the plan where it was and compare it to the actual. Recommended usage is to zero out the seconds and microseconds to avoid spurious precision.</skos:scopeNote>
    <skos:prefLabel>planned start minute</skos:prefLabel>
    <skos:example>'2021-06-01T08:32:00-6:00'^^xsd:dateTime</skos:example>
    <skos:definition>The date and time that something is or was planned to start, with precision of one minute.</skos:definition>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/plannedStartDateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Permission">
    <skos:prefLabel>Permission</skos:prefLabel>
    <skos:definition>A description of things one is permitted to do. This could be broad, such as free speech, but more often is very specific, such as the right of egress through a particular property.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A16"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A17">
    <owl:intersectionOf rdf:nodeID="A18"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
