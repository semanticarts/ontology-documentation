    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasAddend">
    <skos:scopeNote>Commonly used with financial metrics.</skos:scopeNote>
    <skos:prefLabel>has addend</skos:prefLabel>
    <skos:example>In the equation 'profit = revenue - expenses', revenue is an addend and expenses is a subtrahend.</skos:example>
    <skos:definition>Relates an aspect to another aspect that is an additive component of it.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A36">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMemberOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A37">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/Commitment">
    <skos:prefLabel>Commitment</skos:prefLabel>
    <skos:definition>An obligation (possibly unilateral).</skos:definition>
    <owl:equivalentClass rdf:nodeID="A38"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/ScheduledEvent">
    <skos:scopeNote>If the event already started, but has not yet ended, it is a contemporary event with an actual start datetime. If the event is over, it is a historical event having an actual end datetime. The event always retains its planned start datetime, and thus continues to be a scheduled event.</skos:scopeNote>
    <skos:prefLabel>Scheduled Event</skos:prefLabel>
    <skos:definition>An event with a planned start datetime.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A39"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A33">
    <rdf:rest rdf:nodeID="A40"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Organization"/>
  </rdf:Description>
