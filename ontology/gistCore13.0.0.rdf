    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance"/>
    <owl:onProperty rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isMadeUpOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
