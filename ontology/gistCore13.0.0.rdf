  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/hasParticipant">
    <skos:scopeNote>This will most often be used as an abstract property. Use subproperties that indicate the nature of the participation (e.g. hasBorrower, hasVenue).</skos:scopeNote>
    <skos:scopeNote>The thing with participants will often be an agreement, event or obligation. Participation does not imply agency.</skos:scopeNote>
    <skos:prefLabel>has participant</skos:prefLabel>
    <skos:example>An event of transferring money has a participating account that receives the money.</skos:example>
    <skos:definition>Relates something (e.g. an agreement) to things that play a role, or take part or are otherwise involved in some way.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/data/gist/_Aspect_area">
    <skos:prefLabel>area</skos:prefLabel>
    <skos:editorialNote>This instance has been duplicated from reference data so it can be used in property restrictions.</skos:editorialNote>
    <skos:definition>The aspect area.</skos:definition>
    <rdf:type rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Aspect"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A178">
    <rdf:rest rdf:nodeID="A179"/>
    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Artifact"/>
  </rdf:Description>
