  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/GovernedGeoRegion">
    <skos:scopeNote>Geographic regions do not need not be physically contiguous in order to constitute a governed geo-region; e.g., Alaska and Hawaii.</skos:scopeNote>
    <skos:prefLabel>Governed Geo-Region</skos:prefLabel>
    <skos:definition>A defined geographic area or areas governed by at least one government organization.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A143"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A144">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isDirectPartOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A145">
    <owl:inverseOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/isDirectPartOf"/>
