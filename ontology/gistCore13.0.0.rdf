  <rdf:Description rdf:about="https://w3id.org/semanticarts/ns/ontology/gist/PhysicalAddress">
    <skos:prefLabel>Physical Address</skos:prefLabel>
    <skos:example>A street address, a PO box address.</skos:example>
    <skos:definition>An address that refers to a locatable place within the physical universe.</skos:definition>
    <owl:equivalentClass rdf:nodeID="A222"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Address"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
