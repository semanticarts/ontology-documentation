    <rdf:first rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Magnitude"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A447">
    <owl:someValuesFrom rdf:resource="https://w3id.org/semanticarts/ns/ontology/gist/Event"/>
